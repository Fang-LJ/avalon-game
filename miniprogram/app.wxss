/* Figma 阿瓦隆游戏 UI / shared Variables */
page {
  --bg: #101713;
  --elevated: #18221d;
  --soft: #223027;
  --text: #f5f1e8;
  --muted: #b8b7af;
  --good: #46c2a3;
  --evil: #c95d68;
  --gold: #d8b25c;
  --border: #324238;
  --accent: #3e6f58;
  background: var(--bg);
  color: var(--text);
  font-family: 'Noto Sans SC', 'PingFang SC', sans-serif;
  font-size: 25rpx;
  line-height: 1.5;
}
view,
button,
input,
image {
  box-sizing: border-box;
}
.page {
  min-height: 100vh;
  padding: 0 38rpx calc(42rpx + env(safe-area-inset-bottom));
}
.page.tabs {
  padding-bottom: calc(165rpx + env(safe-area-inset-bottom));
}
.title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.45;
}
.subtitle,
.muted {
  color: var(--muted);
  font-size: 23rpx;
}
.small {
  font-size: 21rpx;
}
.gold {
  color: var(--gold);
}
.good {
  color: var(--good);
}
.evil {
  color: var(--evil);
}
.section-title {
  font-size: 29rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.card {
  background: var(--elevated);
  border: 1px solid var(--border);
  border-radius: 35rpx;
  padding: 29rpx;
}
.card > view + view {
  margin-top: 12rpx;
}
.stack > view + view,
.stack > game-card + game-card {
  margin-top: 24rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.between {
  justify-content: space-between;
}
.wrap {
  flex-wrap: wrap;
}
.center {
  text-align: center;
}
.btn {
  width: 100%;
  min-height: 92rpx;
  padding: 23rpx 20rpx;
  border-radius: 31rpx;
  background: var(--accent);
  color: var(--text);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.5;
  border: 1px solid transparent;
  margin: 0;
}
.btn::after {
  border: 0;
}
.btn[disabled] {
  opacity: 0.45;
  background: var(--accent);
  color: var(--text);
}
button.btn[disabled] {
  background: var(--accent) !important;
  color: var(--text) !important;
}
button.btn.ghost[disabled] {
  background: transparent !important;
}
.btn.ghost {
  background: transparent;
  border-color: var(--border);
  font-weight: 500;
}
.btn.success {
  background: var(--good);
  color: var(--bg);
}
.btn.danger {
  background: var(--evil);
}
.btn + .btn {
  margin-top: 23rpx;
}
.actions {
  padding: 0 15rpx;
}
.two-buttons {
  display: flex;
  gap: 40rpx;
}
.two-buttons .btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar image {
  width: 100%;
  height: 100%;
}
.input {
  background: var(--elevated);
  border: 1px solid var(--border);
  border-radius: 27rpx;
  height: 100rpx;
  padding: 25rpx;
  font-size: 29rpx;
  color: var(--text);
}
.input-label {
  color: var(--muted);
  margin-bottom: 14rpx;
  font-size: 23rpx;
}
.empty {
  padding: 45rpx 20rpx;
  text-align: center;
  color: var(--muted);
}
.link {
  color: var(--gold);
  padding: 12rpx 0;
}
.chips {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}
.chip {
  background: var(--soft);
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  font-size: 21rpx;
}
.chip.active {
  background: var(--accent);
}
.error {
  color: var(--evil);
  padding: 20rpx 0;
}
.footer-note {
  color: var(--muted);
  text-align: center;
  font-size: 21rpx;
  margin-top: 27rpx;
}
