<view class="page ui-v3-page ui-v3-tabs me-page" style="padding-top:{{contentTop}}px;">
  <view wx:if="{{error}}" class="error" bindtap="load">{{error}}</view>
  <view class="v3-card profile-entry" bindtap="editProfile">
    <view class="v3-avatar me-avatar">
      <image class="v3-avatar-base" src="/assets/ui-v3/ee5b8.svg" aria-hidden="{{true}}" />
      <image wx:if="{{profile.avatarUrl}}" class="v3-avatar-photo" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <text wx:else class="v3-avatar-letter">{{profile.initial || 'A'}}</text>
    </view>
    <view class="profile-copy"><view class="profile-name">{{profile.nickname || '正在加载…'}}</view><view class="profile-connection">{{mockLogin ? '本地测试账号' : '微信账号已连接'}}</view></view>
    <image class="edit-profile-icon" src="/assets/ui-v3/62e26.svg" aria-label="编辑头像与昵称" />
  </view>
  <view class="v3-card my-data">
    <view class="my-data-title">我的战绩</view>
    <view class="my-metrics">
      <view class="my-metric"><view class="metric-value">{{stats ? stats.totalGames : '—'}}</view><view class="metric-label">总对局</view></view>
      <view class="my-metric"><view class="metric-value">{{stats ? stats.wins : '—'}}</view><view class="metric-label">胜场</view></view>
      <view class="my-metric"><view class="metric-value gold">{{stats ? stats.winRate : 0}}%</view><view class="metric-label">胜率</view></view>
    </view>
  </view>
  <view class="menu-group-label">游戏</view>
  <view class="v3-card settings-menu">
    <view class="settings-row" bindtap="history"><text>历史战绩</text><image src="/assets/ui-v3/4a70d.svg" aria-hidden="{{true}}" /></view>
    <view class="settings-row" bindtap="rules"><text>规则与角色说明</text><image src="/assets/ui-v3/4a70d.svg" aria-hidden="{{true}}" /></view>
  </view>
  <view class="menu-group-label">更多</view>
  <view class="v3-card settings-menu">
    <view class="settings-row" bindtap="agreement"><text>用户服务协议</text><image src="/assets/ui-v3/4a70d.svg" aria-hidden="{{true}}" /></view>
    <view class="settings-row" bindtap="privacy"><text>隐私政策</text><image src="/assets/ui-v3/4a70d.svg" aria-hidden="{{true}}" /></view>
  </view>
  <button class="logout-button" bindtap="logout">退出登录</button>
  <app-tab-bar active="me" v3="{{true}}" />
</view>
