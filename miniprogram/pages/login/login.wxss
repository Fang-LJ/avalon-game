.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
.brand {
  text-align: center;
  padding-top: max(250rpx, env(safe-area-inset-top));
}
.brand-mark {
  width: 177rpx;
  height: 177rpx;
  position: relative;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 73rpx;
  font-weight: 700;
  color: var(--gold);
}
.brand-mark image {
  position: absolute;
  width: 100%;
  height: 100%;
}
.brand-mark text {
  z-index: 1;
}
.brand-name {
  margin-top: 50rpx;
  font-size: 58rpx;
  font-weight: 700;
}
.tagline {
  margin-top: 64rpx;
  font-size: 27rpx;
}
.login-actions {
  margin-top: max(110rpx, calc(100vh - 1190rpx));
  padding: 0 15rpx;
}
.legal {
  text-align: center;
  font-size: 19rpx;
  margin-top: 100rpx;
  padding-bottom: 100rpx;
}
.mock-users {
  margin: 25rpx 0;
}
.mock-users .chips {
  margin-top: 20rpx;
}
