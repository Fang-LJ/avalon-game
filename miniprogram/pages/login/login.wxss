.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
.brand {
  text-align: center;
  padding-top: 90px;
}
.brand-mark {
  width: 177rpx;
  height: 177rpx;
  position: relative;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 73rpx;
  font-weight: 700;
  color: var(--gold);
}
.brand-mark image {
  position: absolute;
  width: 100%;
  height: 100%;
}
.brand-mark text {
  z-index: 1;
}
.brand-name {
  margin-top: 30rpx;
  font-size: 58rpx;
  font-weight: 700;
}
.tagline {
  margin-top: 28rpx;
  font-size: 27rpx;
}
.login-actions {
  margin-top: 46rpx;
  padding: 0 15rpx;
}
.mock-users {
  margin: 25rpx 0;
}
.mock-users .chips {
  margin-top: 20rpx;
}
.guest-features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; margin-top: 42rpx; padding: 0 15rpx; }
.guest-feature { margin: 0; padding: 26rpx 16rpx; min-height: 158rpx; background: var(--elevated); border: 1rpx solid var(--border); border-radius: 24rpx; color: var(--text); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; font-size: 27rpx; line-height: 1.4; }
.guest-feature::after { border: 0; }
.feature-icon { width: 48rpx; height: 48rpx; }

.agreement-area { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 26rpx; }
.agreement-checkbox { flex-shrink: 0; width: 42rpx; height: 42rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--muted); border-radius: 6rpx; background: transparent; color: var(--bg); font-size: 28rpx; line-height: 1; }
.agreement-checkbox::after { border: 0; }
.agreement-checkbox.checked { background: var(--gold); border-color: var(--gold); }
.agreement-copy { flex: 1; min-width: 0; font-size: 23rpx; line-height: 1.8; color: var(--muted); overflow-wrap: anywhere; }
.legal-link { color: var(--gold); }
.agreement-hint { margin: 12rpx 0 0 56rpx; font-size: 22rpx; color: var(--muted); }
button.login-button[disabled] { background: #29372e !important; color: #87978b !important; opacity: 1; }
