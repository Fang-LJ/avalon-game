@import "../../styles/ui-v3.wxss";
.login-page { display: flex; flex-direction: column; padding-bottom: max(89px, calc(55px + env(safe-area-inset-bottom))); }
.brand { flex-shrink: 0; text-align: center; }
.brand-mark { position: relative; display: flex; align-items: center; justify-content: center; width: 74px; height: 74px; margin: auto; color: var(--gold); font-size: 30px; font-weight: 700; line-height: 44px; }
.brand-mark image { position: absolute; left: 0; top: 0; width: 74px; height: 74px; }
.brand-mark text { position: relative; }
.brand-name { margin-top: 20px; font-size: 32px; line-height: 46px; font-weight: 700; }
.brand-english { color: var(--gold); font-size: 12px; line-height: 17px; font-weight: 500; }
.guest-features { flex-shrink: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 25rpx 23.077rpx; margin-top: 142.308rpx; }
.guest-feature { display: flex; align-items: center; gap: 21.154rpx; min-width: 0; min-height: 62px; margin: 0; padding: 15px 30.769rpx; border: 1px solid var(--border); border-radius: 30.769rpx; background: var(--elevated); color: var(--text); font-size: 14px; font-weight: 500; line-height: 20px; text-align: left; }
.guest-feature::after { border: 0; }
.feature-icon { width: 22px; height: 22px; flex-shrink: 0; }
.login-actions { flex-shrink: 0; margin-top: auto; padding-top: 40px; }
.agreement-area { display: flex; align-items: center; justify-content: center; margin-top: 20px; font-size: 12px; line-height: 17px; }
.agreement-checkbox { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36px; height: 44px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; line-height: 1; }
.agreement-checkbox::after { border: 0; }
.agreement-circle { position: relative; display: flex; align-items: center; justify-content: center; width: 18px; height: 18px; border: 1px solid #819587; border-radius: 50%; color: var(--bg); font-size: 12px; font-weight: 700; }
.agreement-checkbox.checked .agreement-circle { border: 0; }
.consent-checked { position: absolute; width: 18px; height: 18px; left: 0; top: 0; }
.agreement-circle text { position: relative; }
.agreement-copy { flex: 0 1 auto; min-width: 0; color: var(--muted); overflow-wrap: anywhere; }
.legal-link { color: var(--gold); font-weight: 500; }
.mock-users .chips { margin-top: 12px; }
