.home { display: flex; flex-direction: column; justify-content: center; }
.hero { margin: 36rpx 16rpx 44rpx; }
.eyebrow { color: #ad8d4f; font-size: 24rpx; letter-spacing: 8rpx; }
.title { margin-top: 20rpx; font-size: 88rpx; color: #173f35; font-weight: 750; }
.subtitle { color: #65756e; font-size: 30rpx; margin-top: 18rpx; }
.actions { padding: 36rpx; }
.actions .btn { height: 104rpx; line-height: 104rpx; }
.return { background: transparent; color: #8b6b32; font-size: 27rpx; }
.mock-login { padding: 28rpx; }
.mock-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22rpx; }
.mock-title { color: #173f35; font-size: 30rpx; font-weight: 650; }
.mock-status { color: #ad8d4f; font-size: 24rpx; }
.mock-users { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.mock-user { margin: 0; padding: 0; height: 64rpx; line-height: 64rpx; border: 0; border-radius: 16rpx; background: #e4ebe5; color: #315b4d; font-size: 24rpx; }
.mock-user::after { border: 0; }
.mock-user.active { background: #173f35; color: #fffdf7; }
.mock-note { color: #8a948f; font-size: 22rpx; margin-top: 20rpx; }
.rule-note { color: #8a948f; text-align: center; font-size: 24rpx; margin-top: 36rpx; }
