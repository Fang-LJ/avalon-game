@import "../../styles/ui-v3.wxss";
@import "../../styles/history-card.wxss";
.history-page .history-overview { min-height: 141px; padding: 16px; border-radius: 42.308rpx; background: var(--soft); }
.overview-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.overview-label { color: var(--muted); font-size: 13px; font-weight: 500; line-height: 18px; }
.overview-values { margin-top: 7px; }
.history-total { min-width: 0; font-size: 23px; font-weight: 700; line-height: 34px; overflow-wrap: anywhere; }
.history-rate { flex-shrink: 0; color: var(--gold); font-size: 26px; font-weight: 700; line-height: 37px; text-align: right; }
.record-bar { display: flex; height: 8px; margin-top: 8px; border-radius: 4px; overflow: hidden; background: var(--border); }
.record-wins { background: var(--good); }
.record-losses { background: var(--evil); }
.record-legend { display: flex; justify-content: space-between; gap: 12px; margin-top: 6px; font-size: 12px; font-weight: 500; line-height: 17px; }
.history-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30.769rpx; margin-top: 42.308rpx; }
.record-filter { display: flex; align-items: center; justify-content: center; gap: 10px; min-width: 0; height: 48px; margin: 0; padding: 0 6px; border: 1px solid var(--gold); border-radius: 28.846rpx; background: var(--elevated); color: var(--gold); font-size: 16px; font-weight: 500; line-height: 18px; }
.record-filter::after { border: 0; }
.filter-good { border-color: var(--good); color: var(--good); }
.filter-evil { border-color: var(--evil); color: var(--evil); }
.filter-good.selected { background: var(--good); color: var(--bg); }
.filter-evil.selected { background: var(--evil); color: var(--bg); }
.history-label { margin: 48rpx 0 12px; }
.history-game { margin-bottom: 24rpx; }
