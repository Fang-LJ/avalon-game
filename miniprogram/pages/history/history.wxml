<view class="page ui-v3-page ui-v3-tabs history-page">
  <view class="v3-nav-wrap">
  <page-head v3="{{true}}" title="历史战绩" subtitle="你的每一局阿瓦隆" />
  </view>
  <view class="v3-card history-overview">
    <view class="overview-row overview-label"><text>对局概览</text><text>胜率</text></view>
    <view class="overview-row overview-values"><view class="history-total">{{stats ? stats.totalGames : '—'}} 场有效对局</view><view class="history-rate">{{stats ? stats.winRate : 0}}%</view></view>
    <view class="record-bar"><view class="record-wins" style="width:{{recordWinPercent}}%;"></view><view class="record-losses" style="width:{{recordLossPercent}}%;"></view></view>
    <view class="record-legend"><text class="good">● {{stats ? stats.wins : 0}} 胜</text><text class="evil">{{stats ? stats.losses : 0}} 负 ●</text></view>
  </view>
  <view class="history-filters">
    <button wx:for="{{filters}}" wx:key="key" class="record-filter filter-{{item.tone}} {{alignment === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="filter" aria-pressed="{{alignment === item.key}}">
      <text>{{item.label}}</text>
    </button>
  </view>
  <view class="v3-section-title history-label">最近对局</view>
  <view wx:for="{{items}}" wx:key="gameId" class="v3-card history-game" data-id="{{item.gameId}}" bindtap="replay">
    <view class="history-title">{{item.roleName}} · {{item.playerCount}}人局</view>
    <view class="history-result {{!item.winner ? 'gold' : item.winner === 'GOOD' ? 'good' : 'evil'}}">{{item.resultText}} · {{!item.winner ? '不计胜负' : item.won ? '胜' : '负'}}</view>
    <view class="history-meta"><text>{{item.timeText}}</text><text class="history-replay">查看复盘 →</text></view>
  </view>
  <view wx:if="{{error}}" class="error" bindtap="retry">{{error}}</view>
  <view wx:elif="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{!items.length}}" class="empty">暂无符合条件的对局</view>
  <view wx:elif="{{items.length < total}}" class="link center" bindtap="more">加载更多</view>
  <view wx:else class="footer-note">已显示全部战绩</view>
  <app-tab-bar active="history" v3="{{true}}" />
</view>
