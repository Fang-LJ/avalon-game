<view class="page ui-v3-page profile-page">
  <view class="v3-nav-wrap">
  <page-head v3="{{true}}" back="{{true}}" title="完善个人资料" />
  </view>
  <view wx:if="{{loading}}" class="v3-card v3-state" bindtap="load">正在加载资料…</view>
  <view wx:else class="profile-content">
    <view class="profile-avatar-section">
      <button class="avatar-button" bindtap="openAvatarSheet" disabled="{{uploading || saving}}" aria-label="更换头像">
        <view class="v3-avatar profile-avatar">
          <image class="v3-avatar-base" src="/assets/ui-v3/ce155.svg" aria-hidden="{{true}}" />
          <image wx:if="{{avatarUrl}}" class="v3-avatar-photo" src="{{avatarUrl}}" mode="aspectFill" />
          <text wx:else class="v3-avatar-letter">{{initial || 'A'}}</text>
          <view class="avatar-edit-badge"><image class="avatar-edit-bg" src="/assets/ui-v3/c8350.svg" aria-hidden="{{true}}" /><image class="avatar-edit-camera" src="/assets/ui-v3/24793.svg" aria-hidden="{{true}}" /></view>
        </view>
        <view class="avatar-hint">{{uploading ? '上传中' : '点击更换头像'}}</view>
      </button>
    </view>
    <view class="profile-field">
      <view class="nickname-heading"><text>昵称</text><button class="wechat-nickname" bindtap="focusNickname" disabled="{{uploading || saving}}">使用微信昵称</button></view>
      <input id="profile-nickname" class="nickname-input" type="nickname" maxlength="32" value="{{nickname}}" focus="{{nicknameFocused}}" placeholder="填写昵称" placeholder-class="input-placeholder" disabled="{{uploading || saving}}" bindinput="nicknameInput" bindblur="nicknameBlur" cursor-spacing="24" />
      <view class="nickname-hint">昵称将展示给同局玩家</view>
    </view>
  </view>
  <view wx:if="{{error}}" class="error center" bindtap="{{!nickname && !uploading && !saving ? 'load' : ''}}">{{error}}</view>
  <view class="profile-actions">
    <button class="v3-primary" loading="{{saving}}" disabled="{{loading || !canSave || uploading || saving}}" bindtap="save">{{uploading ? '上传中' : '保存资料'}}</button>
    <button wx:if="{{mode === 'first'}}" class="profile-skip" bindtap="skip" disabled="{{loading || uploading || saving}}">跳过，使用默认资料</button>
  </view>
  <view class="profile-footer-note">头像和昵称以后也可以修改</view>
  <view wx:if="{{avatarSheetOpen}}" class="avatar-sheet-mask" catchtap="closeAvatarSheet">
    <view class="avatar-sheet" catchtap="keepAvatarSheet" aria-role="dialog" aria-modal="{{true}}" aria-label="更换头像">
      <view class="avatar-sheet-title">更换头像</view>
      <button class="avatar-source" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" disabled="{{uploading || saving}}"><image src="/assets/ui-v3/a6ae1.svg" aria-hidden="{{true}}" /><text>使用微信头像</text></button>
      <button class="avatar-source" bindtap="chooseFromAlbum" disabled="{{uploading || saving}}"><image src="/assets/ui-v3/b96bc.svg" aria-hidden="{{true}}" /><text>从相册选择</text></button>
    </view>
  </view>
</view>
