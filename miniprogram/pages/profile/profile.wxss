.profile-page {
  padding-top: 0;
}
.profile-card {
  padding: 48rpx 34rpx 38rpx;
}
.avatar-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0;
  margin: 0;
  color: var(--text);
  background: transparent;
  line-height: 1.5;
}
.avatar-button::after {
  border: 0;
}
.profile-avatar {
  width: 164rpx;
  height: 164rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--gold);
  border-radius: 50%;
  overflow: hidden;
  color: var(--gold);
  background: var(--soft);
  font-size: 52rpx;
  font-weight: 700;
}
.profile-avatar image {
  width: 100%;
  height: 100%;
}
.album-link {
  margin-top: 6rpx;
  text-align: center;
}
.profile-field {
  margin-top: 38rpx;
}
.input-placeholder {
  color: var(--muted);
}
.profile-actions {
  margin-top: 54rpx;
}
