<view class="page join-page">
  <page-head
    title="加入房间"
    subtitle="{{fromInvite ? '好友邀请你加入房间' : '输入好友分享的 6 位房间号'}}"
    back="{{true}}"
  />
  <view class="join-input">
    <view class="input-label">房间号</view>
    <input
      class="input"
      value="{{roomCode}}"
      type="number"
      maxlength="6"
      disabled="{{loading}}"
      focus="{{inputFocus}}"
      placeholder="请输入 6 位房间号"
      placeholder-class="muted"
      bindinput="codeInput"
    />
    <view class="muted small input-hint">仅支持加入等待中的房间</view>
    <view wx:if="{{fromInvite}}" class="link small other-code" bindtap="editCode">输入其他房间号</view>
  </view>
  <view wx:if="{{error}}" class="error small">{{error}}</view>
  <view class="join-actions actions">
    <button
      class="btn"
      disabled="{{!valid || loading}}"
      loading="{{loading}}"
      bindtap="submit"
    >
      加入房间
    </button>
  </view>
  <view class="muted small join-hint center">也可以让房主直接通过微信分享邀请给你。</view>
</view>
