<view class="page">
  <view class="card">
    <view class="section-title">输入房间号</view>
    <input class="input code" type="number" maxlength="6" placeholder="6 位房间号" value="{{roomCode}}" bindinput="codeInput" />
    <input class="input" maxlength="32" placeholder="你的昵称（可选）" value="{{nickname}}" bindinput="nicknameInput" />
    <button class="btn btn-primary" disabled="{{roomCode.length !== 6 || loading}}" loading="{{loading}}" bindtap="submit">加入房间</button>
  </view>
</view>
