@import "../../styles/ui-v3.wxss";
.invite-details { margin-top: 12px; padding: 18px 17px 20px; border: 1px solid var(--gold); border-radius: 42rpx; background: var(--soft); }
.invite-status { display: inline-flex; align-items: center; gap: 5px; height: 27px; padding: 0 9px; border: .9px solid var(--gold); border-radius: 14px; background: var(--elevated); color: var(--gold); font-size: 12px; }
.invite-status image { width: 7px; height: 7px; }
.invite-title { margin-top: 17px; font-size: 22px; font-weight: 700; line-height: 30px; }
.invite-description { margin-top: 6px; color: var(--muted); font-size: 12px; line-height: 17px; }
.invite-code { display: flex; align-items: center; gap: 28px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--muted); font-size: 12px; }
.invite-code text + text { color: var(--gold); font-size: 24px; font-weight: 700; line-height: 33px; }
.invite-seats-heading { display: flex; justify-content: space-between; gap: 12px; margin-top: 22px; font-size: 14px; font-weight: 500; }
.invite-seats-heading text + text { color: var(--muted); font-size: 13px; }
.invite-seats { display: grid; grid-template-columns: repeat(auto-fit, minmax(32px, 1fr)); gap: 12px 10px; margin-top: 20px; }
.invite-seat { display: flex; flex-direction: column; align-items: center; }
.seat-circle { position: relative; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; color: var(--muted); font-size: 15px; }
.seat-circle image { position: absolute; width: 32px; height: 32px; left: 0; top: 0; }
.seat-circle text { position: relative; }
.seat-number { margin-top: 6px; color: var(--muted); font-size: 10px; line-height: 14px; }
.invite-seated { margin-top: 20px; color: var(--muted); font-size: 12px; line-height: 17px; }
.invite-note { display: flex; align-items: center; gap: 13px; margin-top: 16px; padding: 16px; border-top: 1px solid var(--border); border-radius: 14px; background: var(--elevated); }
.invite-note image { width: 22px; height: 22px; flex-shrink: 0; }
.invite-note > view > view:first-child { font-size: 14px; font-weight: 500; line-height: 19px; }
.invite-note > view > view + view { margin-top: 6px; color: var(--muted); font-size: 11px; line-height: 15px; }
.invite-confirm, .invite-decline { width: 100%; margin: 30px 0 0; min-height: 56px; padding: 15px; border: 0; border-radius: 17px; background: var(--gold); color: var(--bg); font-size: 17px; font-weight: 700; line-height: 24px; }
.invite-confirm::after, .invite-decline::after, .return-home::after, .retry-invite::after { border: 0; }
.invite-confirm[disabled] { background: #29392f; color: #86958b; }
.invite-decline { min-height: 49px; margin-top: 14px; padding: 13px; border: 1px solid var(--border); border-radius: 16px; background: transparent; color: var(--muted); font-size: 14px; font-weight: 500; line-height: 21px; }
.invite-footer { margin-top: 24px; color: var(--muted); text-align: center; font-size: 11px; line-height: 15px; }
.invite-exception { margin-top: 20px; padding: 16px; border: 1px solid var(--border); border-radius: 13px; background: var(--bg); }
.exception-heading { display: flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 500; line-height: 23px; }
.exception-heading image { width: 9px; height: 9px; }
.exception-description { margin-top: 24px; color: var(--muted); font-size: 12px; line-height: 17px; overflow-wrap: anywhere; }
.return-home, .retry-invite { margin: 16px 0 0; padding: 8px 0; background: transparent; color: var(--gold); font-size: 12px; text-align: left; line-height: 20px; }

.seat-circle.occupied { color: var(--gold); }
