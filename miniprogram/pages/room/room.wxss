.room-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}
.lobby-title {
  font-size: 29rpx;
  font-weight: bold;
}
.lobby-room-code {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}
.lobby-label {
  margin-top: 30rpx;
  display: flex; align-items: center; justify-content: space-between; gap: 12rpx;
}
.lobby-board {
  margin-top: 24rpx;
  position: relative;
}
.lobby-center {
  position: absolute;
  top: 46%;
  left: 30%;
  width: 40%;
  transform: translateY(-50%);
  pointer-events: none;
  padding: 0;
  text-align: center;
}
.lobby-population {
  font-size: 34rpx;
  font-weight: 700;
}
.standing-list {
  margin-top: 22rpx;
}
.lobby-rules {
  margin-top: 55rpx;
  line-height: 1.7;
}
.lobby-rules > view + view { margin-top: 12rpx; }
.lobby-actions {
  margin-top: 28rpx;
}
.role-progress { margin: 30rpx 0 20rpx; }
.board {
  height: 720rpx;
  margin-top: 14rpx;
  position: relative;
}
.board.large-table {
  height: 900rpx;
}
.positioned-seat {
  position: absolute;
  transform: translateX(-50%);
}
.board-center {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  left: 25%;
  width: 50%;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  text-align: center;
}
.board-center > view { margin: 0; color: var(--muted); font-size: 20rpx; line-height: 28rpx; overflow-wrap: anywhere; }
.board-center > view + view { margin-top: 8rpx; }
.board-center > view:first-child {
  color: var(--gold);
  font-weight: 800;
  font-size: 26rpx;
  line-height: 34rpx;
  letter-spacing: 1rpx;
}
.board-center.forced-turn { top: 44%; }
.board-center .rejection-status { display: flex; align-items: center; justify-content: center; gap: 9rpx; min-height: 32rpx; margin-top: 8rpx; }
.rejection-label { color: var(--muted); font-size: 18rpx; margin-right: 2rpx; }
.rejection-dot { width: 20rpx; height: 20rpx; border: 1rpx solid var(--border); border-radius: 50%; background: var(--soft); flex-shrink: 0; }
.rejection-dot.rejected { background: var(--evil); border-color: var(--evil); }
.board-center .forced-heading { color: #F0C96A; font-size: 22rpx; font-weight: 800; line-height: 30rpx; }
.board-center .forced-description { color: #d5b7ae; font-size: 18rpx; line-height: 24rpx; white-space: normal; }
.board-center.assassination-center {
  left: 28%;
  width: 44%;
  min-height: 140rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.board-center.assassination-center > view { width: 100%; flex-shrink: 0; margin: 0; }
.board-center.assassination-center .assassination-title { color: var(--gold); font-size: 26rpx; font-weight: 800; line-height: 32rpx; }
.board-center.assassination-center .assassination-rule { color: var(--muted); font-size: 18rpx; font-weight: 400; line-height: 24rpx; white-space: normal; }
.board-center.assassination-center .assassination-selection { color: var(--text); font-size: 20rpx; font-weight: 600; line-height: 26rpx; white-space: normal; overflow-wrap: anywhere; }
.team-choice-hint { margin-top: 8rpx; text-align: center; font-size: 20rpx; line-height: 28rpx; }
.phase-actions {
  margin-top: 25rpx;
}
.lady-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  justify-items: center;
  gap: 32rpx;
  margin: 60rpx 0;
}
.winner {
  font-size: 46rpx;
  font-weight: bold;
}
.identity-list {
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
}
.settlement-groups { margin-top: 36rpx; }
.settlement-groups > .identity-list:first-child { margin-top: 0; }
.settlement-good { color: #65c7df; background: rgba(101,199,223,.045); border-color: rgba(101,199,223,.35); }
.settlement-evil { color: var(--evil); background: rgba(201,93,104,.045); border-color: rgba(201,93,104,.35); }
.identity-group-heading { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0 12rpx; font-size: 26rpx; font-weight: 700; }
.identity-group-count { font-size: 21rpx; font-weight: 400; opacity: .8; }
.identity-player-info { color: var(--text); }
.identity-role.special-role-tag { border: 1rpx solid; border-radius: 999rpx; padding: 4rpx 12rpx; white-space: nowrap; }
.identity-role.role-merlin { color: #f0d58c; background: rgba(240,213,140,.10); border-color: rgba(240,213,140,.40); text-shadow: 0 0 10rpx rgba(240,213,140,.25); }
.identity-role.role-percival { color: #c3aeff; background: rgba(182,156,255,.10); border-color: rgba(182,156,255,.42); text-shadow: 0 0 10rpx rgba(182,156,255,.20); }
.special-role-symbol { font-size: 19rpx; line-height: 1; }
.identity-row {
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr) max-content;
  align-items: center;
  gap: 16rpx;
  min-height: 92rpx;
  margin: 0 !important;
  font-size: 23rpx;
}
.identity-row + .identity-row { border-top: 1px solid var(--border); }
.identity-avatar { width: 68rpx; height: 68rpx; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--soft); font-size: 29rpx; font-weight: 700; }
.identity-avatar image { width: 100%; height: 100%; }
.identity-player-info { min-width: 0; display: flex; align-items: center; white-space: nowrap; }
.identity-seat { flex-shrink: 0; }
.identity-nickname { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.identity-role { white-space: nowrap; text-align: right; display: block; line-height: 34rpx; margin: 0 !important; }
.finish-actions {
  margin-top: 56rpx;
}
.private-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 38rpx;
}
.private-result {
  width: 100%;
  border-color: var(--gold);
}
.result-alignment {
  font-size: 35rpx;
  font-weight: bold;
}
.private-result .btn {
  margin-top: 35rpx;
}
.private-role-trigger {
  color: var(--gold);
}
.role-overlay-card {
  max-height: 82vh;
  overflow-y: auto;
  text-align: center;
}
.role-overlay-art { margin: 22rpx auto !important; }
.role-overlay-instruction {
  margin-top: 30rpx !important;
  font-size: 27rpx;
}
.role-overlay-vision {
  margin-top: 34rpx !important;
  padding-top: 24rpx;
  border-top: 1px solid var(--border);
}
.role-overlay-player {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-top: 14rpx !important;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: var(--soft);
}
.vision-seat, .vision-label { flex-shrink: 0; white-space: nowrap; }
.vision-nickname { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
.vision-label { padding: 6rpx 10rpx; border-radius: 12rpx; color: #FFFFFF; font-size: 22rpx; font-weight: 900; line-height: 1; }
.vision-label-evil { background: #A93447; }
.vision-label-candidate { background: #8052C1; }
.knowledge-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  font-weight: 900;
}
.knowledge-inline.knowledge-evil {
  background: transparent;
}
.knowledge-inline.knowledge-candidate {
  background: transparent;
}
.has-phase-actions {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}
.room-page .phase-actions {
  position: fixed;
  left: 38rpx;
  right: 38rpx;
  bottom: 0;
  margin: 0;
  padding: 18rpx 0 calc(14rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  z-index: 20;
}
.phase-actions .footer-note {
  margin: 12rpx 0 0;
}
.room-page .lady-grid {
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 10rpx;
  margin: 45rpx 0;
}
.bot-add::after { border: none; }
.bot-tools { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.bot-add { flex-shrink: 0; background: var(--soft); color: var(--gold); font-size: 23rpx; border: 1px solid var(--border); border-radius: 999rpx; margin: 0; padding: 0 20rpx; line-height: 60rpx; }
button.bot-add[disabled] { background: var(--soft) !important; color: var(--muted) !important; opacity: 0.45; }
.game-status-row { display: flex; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 8rpx; }
.game-status-row mission-track { flex-shrink: 0; }
.room-quick-actions { display: flex; align-items: center; gap: 4rpx; margin-left: auto; }
.quick-action { min-width: 60rpx; min-height: 88rpx; padding: 0 6rpx; margin: 0; line-height: 88rpx; font-size: 21rpx; color: var(--muted); background: transparent; white-space: nowrap; }
.quick-action::after { border: 0; }
button.quick-action.private-role-trigger { color: var(--gold); }
button.quick-action.early-assassination-trigger { color: var(--evil); white-space: nowrap; }
button.quick-action[disabled] { background: transparent !important; color: var(--muted) !important; opacity: 0.45; }
.lobby-card { padding: 24rpx; }
.lobby-card-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.lobby-close-action { flex-shrink: 0; padding-left: 12rpx; line-height: 44rpx; font-size: 22rpx; color: var(--evil); white-space: nowrap; }
.lobby-close-action.disabled { opacity: 0.4; }
.lobby-card .lobby-player-count { margin-top: 6rpx; }
.lobby-invite-actions { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 16rpx; }
.lobby-card .lobby-invite-actions { margin-top: 16rpx; }
.invite-button, .copy-code-button { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 74rpx; margin: 0; padding: 0 12rpx; line-height: 1.3; font-size: 24rpx; border: 1px solid transparent; border-radius: 24rpx; white-space: nowrap; }
.invite-button { color: var(--bg); background: var(--gold); }
.copy-code-button { color: var(--gold); background: var(--soft); border-color: var(--border); font-size: 23rpx; }
.invite-button::after, .copy-code-button::after { border: 0; }

button.nomination-button { background: #D8B25C; color: #101713; font-weight: 700; }
button.nomination-button[disabled] { background: #D8B25C !important; color: #101713 !important; opacity: .45; }

.lobby-card-heading { flex-wrap: wrap; row-gap: 14rpx; }
.lobby-room-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; margin-left: auto; }
.lobby-room-actions .lobby-room-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-width: 64rpx; height: 56rpx; margin: 0; padding: 0 12rpx; border: 1rpx solid var(--border); border-radius: 14rpx; background: var(--soft); color: var(--gold); font-size: 22rpx; font-weight: 700; line-height: 1; white-space: nowrap; }
.lobby-room-actions .lobby-room-button::after { border: 0; }
.lobby-room-actions .bot-add { width: 64rpx; font-size: 32rpx; }
.lobby-room-actions .lobby-room-button[disabled] { background: var(--soft) !important; color: var(--muted) !important; opacity: .45; }
.lobby-card .lobby-invite-actions { margin-top: 20rpx; }
.lobby-card .lobby-rules { margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid var(--border); line-height: 1.7; }
.lobby-card .lobby-rules > .gold { font-size: 23rpx; font-weight: 700; }
.lobby-card .lobby-rules > view + view { margin-top: 8rpx; }

/* Only lobby and identity confirmation use a bounded viewport. Active games retain page scrolling. */
.room-page.preparation-page { position: fixed; inset: 0; height: 100%; height: 100dvh; min-height: 0; padding-bottom: 0; display: flex; flex-direction: column; overflow: hidden; }
.preparation-page > page-head, .preparation-page > .game-status-row, .preparation-page > .error { flex-shrink: 0; }
.preparation-scroll { flex: 1; height: 0; min-height: 0; width: 100%; overscroll-behavior-y: none; }
.lobby-body { display: flex; flex-direction: column; min-height: 100%; box-sizing: border-box; padding-bottom: 12rpx; }
.lobby-info { border-top: 1rpx solid #324238; border-bottom: 1rpx solid #324238; padding: 18rpx 0; }
.lobby-info .lobby-card-heading { flex-wrap: nowrap; }
.lobby-info .lobby-room-actions { margin: 16rpx 0 0; justify-content: flex-start; gap: 12rpx; }
.lobby-info .lobby-room-button { flex: 1; min-width: 0; width: auto; padding: 0 4rpx; font-size: 21rpx; height: 60rpx; }
.lobby-info .lobby-leave-action { background: transparent; color: var(--muted); }
.lobby-info .lobby-close-action { background: transparent; color: #c95d68; border-color: #69383d; }
/* Natural orbit height is supplied by lobbyGeometry; free space cannot stretch its axes. */
.preparation-page .lobby-board, .preparation-page .lobby-board.large-table { flex: 0 0 auto; min-height: 0; width: 100%; margin-top: 22rpx; }
.lobby-info .bot-add[disabled] { background: #29392f !important; color: #86958b !important; opacity: 1; }
.preparation-page .lobby-rules { margin-top: 20rpx; line-height: 1.6; }
.lobby-footer { flex-shrink: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16rpx; padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom)); }
.lobby-footer.host-footer { grid-template-columns: minmax(0, 65fr) minmax(0, 35fr); }
.lobby-footer.host-footer.room-full { grid-template-columns: minmax(0, 35fr) minmax(0, 65fr); }
.lobby-footer button { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 92rpx; min-height: 92rpx; margin: 0; padding: 0 8rpx; border: 0; border-radius: 26rpx; font-size: 27rpx; font-weight: 700; line-height: 1.3; }
.lobby-footer button::after { border: 0; }
.lobby-invite { background: #D8B25C; color: #101713; }
.lobby-footer button[disabled] { background: #29392f !important; color: #86958b !important; opacity: 1; }
/* Keep the ready appearance on the final roster update while the add request unlocks.
   The native disabled attribute and handler still prevent concurrent start requests. */
.lobby-footer .lobby-start.bot-add-locked[disabled] { background: var(--accent) !important; color: var(--text) !important; }
.identity-body { padding: 12rpx 0 calc(20rpx + env(safe-area-inset-bottom)); }
.identity-body .role-progress { margin-bottom: 0; }
