.room-page {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}
.lobby-title {
  font-size: 31rpx;
  font-weight: bold;
}
.room-code {
  font-size: 50rpx;
  font-weight: bold;
}
.lobby-label {
  margin-top: 24rpx;
}
.lobby-board {
  height: 820rpx;
  margin-top: 32rpx;
  position: relative;
}
.lobby-board.large-table {
  height: 960rpx;
}
.lobby-center {
  position: absolute;
  top: 35%;
  left: 25%;
  width: 50%;
  padding: 22rpx 12rpx;
  text-align: center;
}
.room-code-small {
  font-size: 34rpx;
  font-weight: 700;
}
.standing-list {
  margin-top: 22rpx;
}
.lobby-rules {
  margin-top: 55rpx;
}
.lobby-actions {
  margin-top: 28rpx;
}
.role-progress { margin: 30rpx 0 20rpx; }
.board {
  height: 890rpx;
  margin-top: 50rpx;
  position: relative;
}
.board.large-table {
  height: 960rpx;
}
.positioned-seat {
  position: absolute;
  transform: translateX(-50%);
}
.board-center {
  position: absolute;
  top: 35%;
  left: 21%;
  width: 58%;
  padding: 25rpx 16rpx;
  text-align: center;
}
.board-center > view:first-child {
  font-weight: bold;
  font-size: 28rpx;
}
.phase-actions {
  margin-top: 25rpx;
}
.mission-info {
  margin-top: 40rpx;
}
.mission-select {
  margin-top: 32rpx;
}
.mission-select .section-title {
  margin-bottom: 10rpx;
}
.mission-hint { margin-bottom: 28rpx; }
.mission-cards { display: flex; justify-content: center; gap: 38rpx; padding: 12rpx 0; }
.mission-card-option { text-align: center; }
.mission-card-label { margin-top: 20rpx; font-size: 24rpx; }
.privacy-note {
  margin-top: 28rpx;
  margin-bottom: 32rpx;
}
.lady-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  justify-items: center;
  gap: 32rpx;
  margin: 60rpx 0;
}
.winner {
  font-size: 46rpx;
  font-weight: bold;
}
.identity-list {
  margin-top: 80rpx;
}
.identity-row {
  display: flex;
  gap: 30rpx;
  font-size: 23rpx;
}
.identity-row text:first-child {
  width: 180rpx;
}
.finish-actions {
  margin-top: 130rpx;
}
.private-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 38rpx;
}
.private-result {
  width: 100%;
  border-color: var(--gold);
}
.result-alignment {
  font-size: 35rpx;
  font-weight: bold;
}
.private-result .btn {
  margin-top: 35rpx;
}
.private-role-trigger {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 20rpx);
  right: 38rpx;
  z-index: 25;
  padding: 11rpx 20rpx;
  border: 1px solid var(--gold);
  border-radius: 999rpx;
  color: var(--gold);
  background: var(--elevated);
  font-size: 21rpx;
}
.role-overlay-card {
  max-height: 82vh;
  overflow-y: auto;
  text-align: center;
}
.role-overlay-art { margin: 22rpx auto !important; }
.role-overlay-instruction {
  margin-top: 30rpx !important;
  font-size: 27rpx;
}
.role-overlay-vision {
  margin-top: 34rpx !important;
  padding-top: 24rpx;
  border-top: 1px solid var(--border);
}
.role-overlay-player {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx !important;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: var(--soft);
}
.knowledge-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  font-weight: 900;
}
.knowledge-inline.knowledge-evil {
  color: var(--text);
  background: var(--evil);
}
.knowledge-inline.knowledge-candidate {
  color: var(--bg);
  background: var(--gold);
}
.has-phase-actions {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}
.room-page .board {
  height: 820rpx;
  margin-top: 36rpx;
}
.room-page .board.large-table {
  height: 960rpx;
}
.room-page .phase-actions {
  position: fixed;
  left: 38rpx;
  right: 38rpx;
  bottom: 0;
  margin: 0;
  padding: 18rpx 0 calc(14rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  z-index: 20;
}
.phase-actions .footer-note {
  margin: 12rpx 0 0;
}
.room-page .lady-grid {
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 10rpx;
  margin: 45rpx 0;
}
.host-controls { display: flex; justify-content: flex-end; margin-bottom: 16rpx; }
.host-end { background: transparent; color: var(--muted); font-size: 24rpx; padding: 0 20rpx; margin: 0; line-height: 64rpx; }
.host-end::after, .bot-add::after { border: none; }
.bot-tools { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.bot-add { flex-shrink: 0; background: var(--soft); color: var(--gold); font-size: 23rpx; border: 1px solid var(--border); border-radius: 999rpx; margin: 0; padding: 0 20rpx; line-height: 60rpx; }
button.bot-add[disabled] { background: var(--soft) !important; color: var(--muted) !important; opacity: 0.45; }
