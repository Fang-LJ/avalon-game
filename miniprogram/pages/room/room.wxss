.room-page {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}
.lobby-title {
  font-size: 31rpx;
  font-weight: bold;
}
.room-code {
  font-size: 50rpx;
  font-weight: bold;
}
.lobby-label {
  margin-top: 24rpx;
}
.lobby-board {
  height: 820rpx;
  margin-top: 32rpx;
  position: relative;
}
.lobby-board.large-table {
  height: 960rpx;
}
.lobby-center {
  position: absolute;
  top: 35%;
  left: 25%;
  width: 50%;
  padding: 22rpx 12rpx;
  text-align: center;
}
.room-code-small {
  font-size: 34rpx;
  font-weight: 700;
}
.standing-list {
  margin-top: 22rpx;
}
.lobby-rules {
  margin-top: 55rpx;
}
.lobby-actions {
  margin-top: 28rpx;
}
.role-progress { margin: 30rpx 0 20rpx; }
.board {
  height: 720rpx;
  margin-top: 14rpx;
  position: relative;
}
.board.large-table {
  height: 900rpx;
}
.positioned-seat {
  position: absolute;
  transform: translateX(-50%);
}
.board-center {
  position: absolute;
  top: 43%;
  left: 25%;
  width: 50%;
  padding: 8rpx 12rpx;
  text-align: center;
}
.board-center > view { font-size: 21rpx; line-height: 1.3; }
.board-center > view + view { margin-top: 4rpx; }
.board-center > view:first-child {
  font-weight: bold;
  font-size: 24rpx;
}
.phase-actions {
  margin-top: 25rpx;
}
.lady-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  justify-items: center;
  gap: 32rpx;
  margin: 60rpx 0;
}
.winner {
  font-size: 46rpx;
  font-weight: bold;
}
.identity-list {
  margin-top: 36rpx;
  padding: 12rpx 24rpx;
}
.identity-row {
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr) max-content;
  align-items: center;
  gap: 16rpx;
  min-height: 92rpx;
  margin: 0 !important;
  font-size: 23rpx;
}
.identity-row + .identity-row { border-top: 1px solid var(--border); }
.identity-avatar { width: 68rpx; height: 68rpx; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--soft); font-size: 29rpx; font-weight: 700; }
.identity-avatar image { width: 100%; height: 100%; }
.identity-player-info { min-width: 0; display: flex; align-items: center; white-space: nowrap; }
.identity-seat { flex-shrink: 0; }
.identity-nickname { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.identity-role { white-space: nowrap; text-align: right; display: block; line-height: 34rpx; margin: 0 !important; }
.finish-actions {
  margin-top: 56rpx;
}
.private-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 38rpx;
}
.private-result {
  width: 100%;
  border-color: var(--gold);
}
.result-alignment {
  font-size: 35rpx;
  font-weight: bold;
}
.private-result .btn {
  margin-top: 35rpx;
}
.private-role-trigger {
  color: var(--gold);
}
.role-overlay-card {
  max-height: 82vh;
  overflow-y: auto;
  text-align: center;
}
.role-overlay-art { margin: 22rpx auto !important; }
.role-overlay-instruction {
  margin-top: 30rpx !important;
  font-size: 27rpx;
}
.role-overlay-vision {
  margin-top: 34rpx !important;
  padding-top: 24rpx;
  border-top: 1px solid var(--border);
}
.role-overlay-player {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx !important;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: var(--soft);
}
.knowledge-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  font-weight: 900;
}
.knowledge-inline.knowledge-evil {
  color: var(--text);
  background: var(--evil);
}
.knowledge-inline.knowledge-candidate {
  color: var(--bg);
  background: var(--gold);
}
.has-phase-actions {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}
.room-page .phase-actions {
  position: fixed;
  left: 38rpx;
  right: 38rpx;
  bottom: 0;
  margin: 0;
  padding: 18rpx 0 calc(14rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  z-index: 20;
}
.phase-actions .footer-note {
  margin: 12rpx 0 0;
}
.room-page .lady-grid {
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 10rpx;
  margin: 45rpx 0;
}
.host-controls { display: flex; justify-content: flex-end; margin-bottom: 16rpx; }
.host-end { background: transparent; color: var(--muted); font-size: 24rpx; padding: 0 20rpx; margin: 0; line-height: 64rpx; }
.host-end::after, .bot-add::after { border: none; }
.bot-tools { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.bot-add { flex-shrink: 0; background: var(--soft); color: var(--gold); font-size: 23rpx; border: 1px solid var(--border); border-radius: 999rpx; margin: 0; padding: 0 20rpx; line-height: 60rpx; }
button.bot-add[disabled] { background: var(--soft) !important; color: var(--muted) !important; opacity: 0.45; }
.game-status-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.game-status-row mission-track { flex-shrink: 0; }
.room-quick-actions { display: flex; align-items: center; gap: 4rpx; }
.quick-action { min-width: 72rpx; min-height: 88rpx; padding: 0 8rpx; margin: 0; line-height: 88rpx; font-size: 21rpx; color: var(--muted); background: transparent; }
.quick-action::after { border: 0; }
button.quick-action.private-role-trigger { color: var(--gold); }
button.quick-action[disabled] { background: transparent !important; color: var(--muted) !important; opacity: 0.45; }
