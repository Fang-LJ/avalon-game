<view
  class="page room-page {{game && game.phase !== 'ROLE_CONFIRM' && game.phase !== 'FINISHED' ? 'has-phase-actions' : ''}}"
  wx:if="{{room}}"
>
  <page-head
    title="{{game && (game.phase === 'TEAM_BUILDING' || game.phase === 'TEAM_VOTING' || game.phase === 'MISSION_EXECUTING') ? '第 ' + game.missionNo + ' 轮 · ' + phaseTitle : phaseTitle}}"
    subtitle="{{game && game.phase === 'ROLE_CONFIRM' ? '仅你自己可见 · 请注意遮挡屏幕' : '房间 ' + room.roomCode + ' · ' + room.maxPlayers + ' 人局'}}"
  />
  <view wx:if="{{error}}" class="error" bindtap="refresh">{{error}}</view>
  <view wx:if="{{room.testGame}}" class="footer-note">机器人测试局 · 不保存历史/战绩 · 结算保留 2 分钟</view>
  <view wx:if="{{room.host && (!game || game.phase !== 'FINISHED')}}" class="host-controls">
    <button class="host-end" disabled="{{busy}}" bindtap="endGame">{{game ? '结束本局' : '关闭房间'}}</button>
  </view>
  <block wx:if="{{!game}}">
    <view class="card">
      <view class="lobby-title">邀请好友加入</view>
      <view class="muted">
        {{room.currentPlayers}} / {{room.maxPlayers}} 人 · 已入座
        {{room.seatedPlayers}} / {{room.maxPlayers}} · {{room.canStart ?
        '房主可以开始游戏' : '等待全员入座'}}
      </view>
      <view class="row" bindtap="copyCode">
        <text class="room-code gold">{{room.roomCode}}</text>
        <text class="muted small">点击复制房间号</text>
      </view>
    </view>
    <view class="section-title lobby-label">固定座位</view>
    <view class="lobby-board {{room.maxPlayers >= 9 ? 'large-table' : ''}}">
      <view
        wx:for="{{displayPlayers}}"
        wx:key="playerId"
        class="positioned-seat"
        style="{{item.position}}"
      >
        <player-seat
          lobby="{{true}}"
          compact="{{room.maxPlayers >= 9}}"
          player="{{item}}"
          bind:select="handleLobbySeat"
        />
      </view>
      <view class="card lobby-center">
        <view class="gold room-code-small">{{room.roomCode}}</view>
        <view class="muted small">{{room.mySeatNo ? '我的座位：' + room.mySeatNo + '号' : '当前站立中'}}</view>
      </view>
    </view>
    <view wx:if="{{standingPlayers.length}}" class="card standing-list">
      <view class="gold small">站立玩家</view>
      <view class="muted small" wx:for="{{standingPlayers}}" wx:key="playerId">
        {{item.nickname}}{{item.me ? '（我）' : ''}}
      </view>
    </view>
    <view class="card lobby-rules">
      <view class="gold">本局规则</view>
      <view class="muted small">
        {{room.maxPlayers}} 人局 · {{rule.evilRoles}} · 第 4 个任务需
        {{rule.fourth}} 张失败票{{rule.lady ? ' · 湖中仙女' : ''}}
      </view>
    </view>
    <view class="lobby-actions actions">
      <button wx:if="{{room.host}}" class="btn ghost" disabled="{{busy || room.currentPlayers >= room.maxPlayers}}" bindtap="addBot">添加机器人</button>
      <view wx:if="{{room.host && botPlayers.length}}" class="card bot-list">
        <view class="row bot-row" wx:for="{{botPlayers}}" wx:key="playerId">
          <text class="muted small">{{item.nickname}} · {{item.seatNo}}号位</text>
          <button class="bot-remove" disabled="{{busy}}" data-player-id="{{item.playerId}}" bindtap="removeBot">移除</button>
        </view>
      </view>
      <button
        class="btn"
        disabled="{{!room.canStart || busy}}"
        loading="{{busy}}"
        bindtap="startGame"
      >
        {{room.host ? '开始游戏' : '等待房主开始'}}
      </button>
      <view class="footer-note">仅房主可开始 · 开局后身份随机分配</view>
      <view class="link center small" bindtap="leaveRoom">退出房间</view>
    </view>
  </block>
  <block wx:elif="{{game.phase === 'ROLE_CONFIRM'}}">
    <card-deal-stage wx:if="{{role}}" gameId="{{game.gameId}}" role="{{role}}" busy="{{busy}}"
      bind:reveal="identityRevealed" bind:confirm="confirmRole" />
    <view class="footer-note center role-progress">
      已确认 {{game.confirmedCount}} / {{game.playerCount}} ·
      全员确认后自动进入第 1 轮
    </view>
  </block>
  <block wx:elif="{{game.phase === 'FINISHED'}}">
    <game-card tone="{{!game.winner ? 'gold' : game.winner === 'GOOD' ? 'good' : 'evil'}}">
      <view class="winner {{!game.winner ? 'gold' : game.winner === 'GOOD' ? 'good' : 'evil'}}">
        {{!game.winner ? '房主已结束本局' : (game.winner === 'GOOD' ? '正义' : '邪恶') + '阵营获胜'}}
      </view>
      <view class="muted">{{finished.reasonText || '正在加载结算…'}}</view>
      <view wx:if="{{finished.targetName}}" class="muted small">
        刺杀目标：{{finished.targetName}}
      </view>
    </game-card>
    <view class="card identity-list">
      <view wx:for="{{game.identities}}" wx:key="playerId" class="identity-row">
        <text>{{item.seatNo}} {{item.nickname}}</text>
        <text class="{{item.alignment === 'GOOD' ? 'good' : 'evil'}}">
          {{item.roleName}}
        </text>
      </view>
    </view>
    <view class="finish-actions actions">
      <button wx:if="{{!room.testGame}}" class="btn" bindtap="replay">查看完整复盘</button>
      <button
        wx:if="{{room.host}}"
        class="btn"
        disabled="{{busy || room.currentPlayers !== room.maxPlayers}}"
        bindtap="restart"
      >
        再来一局
      </button>
      <view
        class="footer-note"
        wx:if="{{room.currentPlayers !== room.maxPlayers}}"
      >
        人数不足，不能再来一局
      </view>
      <button class="btn ghost" disabled="{{busy}}" bindtap="leaveRoom">
        退出房间
      </button>
    </view>
  </block>
  <block wx:else>
    <view class="private-role-trigger" bindtap="openRoleOverlay">我的身份</view>
    <mission-track
      wx:if="{{game.phase !== 'LADY_OF_LAKE' && game.phase !== 'ASSASSINATION'}}"
      missions="{{timeline.missions}}"
      current="{{game.missionNo}}"
      good="{{game.goodScore}}"
      evil="{{game.evilScore}}"
    />
    <view wx:if="{{game.phase === 'ASSASSINATION'}}" class="card">
      <view class="evil">
        {{game.assassin ? '轮到你选择刺杀目标' : '等待刺客选择目标'}}
      </view>
      <view class="muted small">正义已完成 3 个任务 · 邪恶最后机会</view>
    </view>
    <view
      wx:if="{{board}}"
      class="board {{room.maxPlayers >= 9 ? 'large-table' : ''}}"
    >
      <view
        wx:for="{{displayPlayers}}"
        wx:key="playerId"
        class="positioned-seat"
        style="{{item.position}}"
      >
        <player-seat
          compact="{{room.maxPlayers >= 9}}"
          formal="{{true}}"
          hideNickname="{{room.maxPlayers >= 9}}"
          player="{{item}}"
          bind:select="togglePlayer"
        />
      </view>
      <view class="card board-center">
        <block wx:if="{{game.phase === 'TEAM_BUILDING'}}">
          <view class="gold">
            {{isLeader ? '请选择任务成员' : '队长正在选择任务成员'}}
          </view>
          <view class="muted">本轮需要 {{game.requiredTeamSize}} 人</view>
          <view class="good small">已选：{{selectedText || '暂无'}}</view>
        </block>
        <block wx:elif="{{game.phase === 'TEAM_VOTING'}}">
          <view class="gold">是否同意这支队伍？</view>
          <view class="muted small">队伍：{{selectedText}}</view>
          <view class="muted small">
            {{game.hasVoted ? '你已投票' : '请投票'}} · {{game.voteCount}} /
            {{game.playerCount}}
          </view>
        </block>
        <block wx:elif="{{game.phase === 'MISSION_EXECUTING'}}">
          <view class="good">组队通过</view>
          <view class="good small">同意：{{voteResult.approveText}}</view>
          <view class="evil small">反对：{{voteResult.rejectText}}</view>
        </block>
        <block wx:elif="{{game.phase === 'ASSASSINATION'}}">
          <view class="gold">
            {{game.assassin ? (targetName ? '已选择：' + targetName :
            '请选择刺杀目标') : '刺客正在寻找梅林'}}
          </view>
          <view class="muted small">确认后不可更改</view>
        </block>
        <block wx:elif="{{game.phase === 'LADY_OF_LAKE'}}">
          <view class="gold">湖中仙女</view>
          <view class="muted small">{{game.ladyHolder ? '请选择检查目标' : '等待持有者操作'}}</view>
        </block>
        <block wx:else>
          <view class="gold">第 {{game.missionNo}} 轮</view>
          <view class="muted small">保持交流，等待当前操作完成</view>
        </block>
      </view>
    </view>
    <block
      wx:if="{{game.phase === 'MISSION_EXECUTING' && game.onMission && !viewVotes}}"
    >
      <view class="card mission-info">
        <view class="gold">你已被选入本轮任务</view>
        <view class="muted">本轮共 {{game.requiredTeamSize}} 名任务成员</view>
        <view class="link small" bindtap="toggleVotes">查看组队投票结果 ›</view>
      </view>
      <view class="card mission-role">
        <view class="gold">秘密任务操作</view>
        <view class="muted small">
          {{game.evil ? '邪恶阵营可以选择 SUCCESS 或 FAIL' : '正义阵营只能选择 SUCCESS'}}
        </view>
      </view>
      <view wx:if="{{!game.hasSubmittedMission}}" class="mission-select">
        <view class="section-title">请选择任务牌</view>
        <view class="two-buttons">
          <button
            class="btn success {{missionChoice === 'SUCCESS' ? 'chosen' : ''}}"
            disabled="{{busy}}"
            bindtap="missionSuccess"
          >
            SUCCESS · 成功
          </button>
          <button
            wx:if="{{game.evil}}"
            class="btn danger {{missionChoice === 'FAIL' ? 'chosen' : ''}}"
            disabled="{{busy}}"
            bindtap="missionFail"
          >
            FAIL · 失败
          </button>
        </view>
      </view>
      <view wx:else class="empty">已秘密提交，等待任务成员</view>
      <view class="card privacy-note">
        <view>你的选择不会公开给其他玩家</view>
        <view class="muted small">
          当前对局只公开最终 SUCCESS / FAIL
          数量；完整出票仅在结束后的参与者复盘中显示。
        </view>
      </view>
    </block>
    <block wx:if="{{game.phase === 'LADY_OF_LAKE'}}">
      <view class="card">
        <view class="gold">当前持有者：{{game.ladyHolderNickname}}</view>
        <view class="muted small">
          第 {{game.missionNo}} 个任务结算后 · {{game.ladyHolder ?
          '选择从未持有过湖中仙女的玩家' : '等待持有者检查阵营'}}
        </view>
      </view>
      <view class="card">
        <view class="gold">
          {{game.ladyHolder ? (targetName ? '已选择：' + targetName :
          '请选择检查目标') : '检查结果仅持有者可见'}}
        </view>
        <view class="muted small">
          检查后自动传递 token；只得知 GOOD / EVIL，不会显示角色。
        </view>
      </view>
    </block>
    <game-log
      wx:if="{{board && game.phase !== 'ASSASSINATION'}}"
      entries="{{entries}}"
    />
    <view class="phase-actions actions">
      <button
        wx:if="{{game.phase === 'TEAM_BUILDING'}}"
        class="btn"
        disabled="{{!isLeader || selectedIds.length !== game.requiredTeamSize || busy}}"
        bindtap="submitTeam"
      >
        {{isLeader ? '确认发车' : '等待队长选人'}}
      </button>
      <view wx:elif="{{game.phase === 'TEAM_VOTING'}}">
        <view wx:if="{{!game.hasVoted}}" class="two-buttons">
          <button class="btn success" disabled="{{busy}}" bindtap="approve">
            同意
          </button>
          <button class="btn danger" disabled="{{busy}}" bindtap="reject">
            反对
          </button>
        </view>
        <button wx:else class="btn" disabled="{{true}}">
          已投票，等待其他玩家
        </button>
      </view>
      <block wx:elif="{{game.phase === 'MISSION_EXECUTING'}}">
        <button
          wx:if="{{game.onMission && viewVotes}}"
          class="btn"
          bindtap="toggleVotes"
        >
          返回秘密任务
        </button>
        <button
          wx:elif="{{game.onMission && !game.hasSubmittedMission}}"
          class="btn"
          disabled="{{!missionChoice || busy}}"
          bindtap="submitMission"
        >
          确认提交
        </button>
        <button wx:else class="btn" disabled="{{true}}">
          等待任务成员提交
        </button>
      </block>
      <button
        wx:elif="{{game.phase === 'LADY_OF_LAKE'}}"
        class="btn"
        disabled="{{!game.ladyHolder || !ladyTarget || busy}}"
        bindtap="inspectLady"
      >
        {{game.ladyHolder ? '确认检查并传递湖中仙女' : '等待持有者操作'}}
      </button>
      <button
        wx:elif="{{game.phase === 'ASSASSINATION'}}"
        class="btn danger"
        disabled="{{!game.assassin || !assassinationTarget || busy}}"
        bindtap="assassinate"
      >
        {{game.assassin ? '确认刺杀' + targetName : '等待刺客行动'}}
      </button>
      <view
        wx:if="{{game.phase === 'TEAM_BUILDING' || game.phase === 'TEAM_VOTING'}}"
        class="footer-note"
      >
        连续否决 {{game.consecutiveRejections}} / {{game.maxRejections}} ·
        {{game.leaderNickname}} 为当前队长
      </view>
    </view>
  </block>
  <view wx:if="{{roleOverlay && role}}" class="private-overlay" catchtap="ignoreTap">
    <view class="card private-result role-overlay-card">
      <view class="muted small">仅你可见</view>
      <view class="role-overlay-art">
        <play-card front="{{roleCardFront}}" back="{{roleCardBack}}" flipped="{{true}}"
          size="medium" interactive="{{false}}" />
      </view>
      <view class="{{role.alignmentCode === 'GOOD' ? 'good' : 'evil'}}">{{role.alignmentName}}</view>
      <view class="role-overlay-instruction">{{role.instruction}}</view>
      <view wx:if="{{role.visiblePlayers.length}}" class="role-overlay-vision">
        <view class="muted small">{{role.visiblePlayers[0].hint}}</view>
        <view wx:for="{{role.visiblePlayers}}" wx:key="playerId" class="role-overlay-player">
          <text>{{item.seatNo}}号 {{item.nickname}}</text>
          <text class="knowledge-inline {{item.knowledgeClass}}">{{item.knowledgeSymbol}}</text>
        </view>
      </view>
      <view wx:else class="muted small">你没有额外角色视野</view>
      <button class="btn" bindtap="closeRoleOverlay">我已查看</button>
    </view>
  </view>
  <view wx:if="{{ladyResult}}" class="private-overlay">
    <view class="card private-result">
      <view class="muted small">湖中仙女结果（仅你可见）</view>
      <view
        class="{{ladyResult.alignment === 'GOOD' ? 'good' : 'evil'}} result-alignment"
      >
        {{ladyResult.targetNickname}} 属于：{{ladyResult.alignment}}
      </view>
      <view class="muted small">湖中仙女已传给该玩家，对局已自动推进。</view>
      <button class="btn" bindtap="dismissLady">我已知晓</button>
    </view>
  </view>
</view>
<view wx:else class="page">
  <page-head title="阿瓦隆" subtitle="正在进入房间…" />
  <view class="error" wx:if="{{error}}" bindtap="refresh">{{error}}</view>
</view>
