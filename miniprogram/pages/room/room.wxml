<view
  class="page room-page {{game && game.phase !== 'ROLE_CONFIRM' && game.phase !== 'FINISHED' ? 'has-phase-actions' : ''}}"
  wx:if="{{room}}"
>
  <page-head
    compact="{{board}}"
    title="{{game && (game.phase === 'TEAM_BUILDING' || game.phase === 'TEAM_VOTING' || game.phase === 'MISSION_EXECUTING') ? '第 ' + game.missionNo + ' 轮 · ' + phaseTitle : phaseTitle}}"
    subtitle="{{game && game.phase === 'ROLE_CONFIRM' ? '仅你自己可见 · 请注意遮挡屏幕' : '房间 ' + room.roomCode + ' · ' + room.maxPlayers + ' 人局'}}"
  />
  <view wx:if="{{error}}" class="error" bindtap="refresh">{{error}}</view>
  <view wx:if="{{game && game.phase !== 'FINISHED'}}" class="game-status-row">
    <mission-track wx:if="{{board}}" missions="{{timeline.missions}}" current="{{game.missionNo}}" bind:missiontap="openMissionDetail" />
    <text wx:else class="muted small">确认身份</text>
    <view class="room-quick-actions">
      <button wx:if="{{canEarlyAssassination}}" class="quick-action early-assassination-trigger" disabled="{{busy}}" bindtap="requestEarlyAssassination">提前刺杀</button>
      <button wx:if="{{board}}" class="quick-action private-role-trigger" disabled="{{busy}}" bindtap="openRoleOverlay">我的身份</button>
      <button class="quick-action" disabled="{{busy}}" bindtap="confirmLeaveRoom">退出</button>
      <button wx:if="{{room.host}}" class="quick-action" disabled="{{busy}}" bindtap="endGame">结束</button>
    </view>
  </view>
  <block wx:if="{{!game}}">
    <view class="card lobby-card">
      <view class="lobby-card-heading">
        <view class="lobby-title">邀请好友加入</view>
        <view wx:if="{{room.host}}" class="lobby-close-action {{busy ? 'disabled' : ''}}" aria-role="button" aria-disabled="{{busy}}" bindtap="endGame">关闭房间</view>
      </view>
      <view class="muted small lobby-player-count">
        {{room.currentPlayers}} / {{room.maxPlayers}} 人 · 已入座
        {{room.seatedPlayers}} / {{room.maxPlayers}}
      </view>
      <view class="muted small lobby-status">{{room.canStart ? '可以开始游戏' : '等待全员入座'}}</view>
      <view class="lobby-room-code">
        <view class="muted small">房间号</view>
        <view class="room-code gold">{{room.roomCode}}</view>
      </view>
      <view class="lobby-invite-actions">
        <button wx:if="{{room.status === 'WAITING'}}" class="invite-button" open-type="share">邀请好友</button>
        <button class="copy-code-button" bindtap="copyCode">复制房号</button>
      </view>
    </view>
    <view class="section-title lobby-label">固定座位</view>
    <view class="lobby-board {{room.maxPlayers >= 9 ? 'large-table' : ''}}">
      <view
        wx:for="{{displayPlayers}}"
        wx:key="playerId"
        class="positioned-seat"
        style="{{item.position}}"
      >
        <player-seat
          lobby="{{true}}"
          compact="{{room.maxPlayers >= 9}}"
          player="{{item}}"
          bind:select="handleLobbySeat"
        />
      </view>
      <view class="card lobby-center">
        <view class="gold lobby-seat-number">{{room.mySeatNo ? room.mySeatNo + '号位' : '当前站立'}}</view>
        <view class="muted small">{{room.mySeatNo ? '我的座位 · 等待好友加入' : '请选择空位坐下'}}</view>
      </view>
    </view>
    <view wx:if="{{standingPlayers.length}}" class="card standing-list">
      <view class="gold small">站立玩家</view>
      <view class="muted small" wx:for="{{standingPlayers}}" wx:key="playerId">
        {{item.nickname}}{{item.me ? '（我）' : ''}}
      </view>
    </view>
    <view class="card lobby-rules">
      <view class="gold">本局规则</view>
      <view class="muted small">
        {{room.maxPlayers}} 人局 · {{rule.evilRoles}} · 第 4 个任务需
        {{rule.fourth}} 张失败票{{rule.lady ? ' · 湖中仙女' : ''}}
      </view>
    </view>
    <view class="lobby-actions actions">
      <view wx:if="{{room.host}}" class="bot-tools">
        <text class="muted small">{{botPlayers.length ? '点击机器人头像可移除' : '可添加机器人补充空位'}}</text>
        <button class="bot-add" disabled="{{busy || room.currentPlayers >= room.maxPlayers}}" bindtap="addBot">＋ 添加机器人</button>
      </view>
      <button
        class="btn"
        disabled="{{!room.canStart || busy}}"
        loading="{{busy}}"
        bindtap="startGame"
      >
        {{room.host ? '开始游戏' : '等待房主开始'}}
      </button>
      <view class="footer-note">仅房主可开始 · 开局后身份随机分配</view>
      <view class="link center small" bindtap="leaveRoom">退出房间</view>
    </view>
  </block>
  <block wx:elif="{{game.phase === 'ROLE_CONFIRM'}}">
    <card-deal-stage wx:if="{{role}}" gameId="{{game.gameId}}" role="{{role}}" busy="{{busy}}"
      bind:reveal="identityRevealed" bind:confirm="confirmRole" />
    <view class="footer-note center role-progress">
      已确认 {{game.confirmedCount}} / {{game.playerCount}} ·
      全员确认后自动进入第 1 轮
    </view>
  </block>
  <block wx:elif="{{game.phase === 'FINISHED'}}">
    <game-card tone="{{!game.winner ? 'gold' : game.winner === 'GOOD' ? 'good' : 'evil'}}">
      <view class="winner {{!game.winner ? 'gold' : game.winner === 'GOOD' ? 'good' : 'evil'}}">
        {{!game.winner ? '房主已结束本局' : (game.winner === 'GOOD' ? '正义' : '邪恶') + '阵营获胜'}}
      </view>
      <view class="muted">{{finished.reasonText || '正在加载结算…'}}</view>
      <view wx:if="{{finished.targetName}}" class="muted small">
        刺杀目标：{{finished.targetName}}
      </view>
    </game-card>
    <view class="settlement-groups">
      <view wx:for="{{finishedGroups}}" wx:for-item="group" wx:key="alignment" class="card identity-list {{group.tone}}">
        <view class="identity-group-heading">
          <text>{{group.title}}{{group.winner ? ' · 胜利' : ''}}</text>
          <text class="identity-group-count">{{group.players.length}}人</text>
        </view>
        <view wx:for="{{group.players}}" wx:key="playerId" class="identity-row">
          <view class="identity-avatar">
            <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
            <text wx:else>{{item.initial}}</text>
          </view>
          <view class="identity-player-info">
            <text class="identity-seat">{{item.seatNo}}号位 · </text>
            <text class="identity-nickname">{{item.nickname}}</text>
          </view>
          <text class="identity-role {{item.roleClass}} {{item.roleClass ? 'special-role-tag' : ''}}"><text wx:if="{{item.roleClass}}" class="special-role-symbol">{{item.roleClass === 'role-merlin' ? '✦' : '◆'}} </text>{{item.roleName}}</text>
        </view>
      </view>
    </view>
    <view class="finish-actions actions">
      <button wx:if="{{!room.testGame}}" class="btn" bindtap="replay">查看完整复盘</button>
      <button
        wx:if="{{room.host}}"
        class="btn"
        disabled="{{busy || room.currentPlayers !== room.maxPlayers}}"
        bindtap="restart"
      >
        再来一局
      </button>
      <view
        class="footer-note"
        wx:if="{{room.currentPlayers !== room.maxPlayers}}"
      >
        人数不足，不能再来一局
      </view>
      <button class="btn ghost" disabled="{{busy}}" bindtap="leaveRoom">
        退出房间
      </button>
    </view>
  </block>
  <block wx:else>
    <view wx:if="{{game.phase === 'ASSASSINATION'}}" class="card">
      <view class="evil">
        {{game.assassin ? '轮到你选择刺杀目标' : '等待刺客选择目标'}}
      </view>
      <view class="muted small">{{game.assassinationEarly ? '提前刺杀 · 不可返回任务阶段' : '正义已完成 3 个任务 · 邪恶最后机会'}} · 邪恶身份已公开</view>
    </view>
    <view
      wx:if="{{board}}"
      class="board {{room.maxPlayers >= 9 ? 'large-table' : ''}}"
    >
      <view
        wx:for="{{displayPlayers}}"
        wx:key="playerId"
        class="positioned-seat"
        style="{{item.position}}"
      >
        <player-seat
          compact="{{room.maxPlayers >= 9}}"
          formal="{{true}}"
          hideNickname="{{room.maxPlayers >= 8}}"
          player="{{item}}"
          bind:select="togglePlayer"
        />
      </view>
      <view class="card board-center">
        <block wx:if="{{game.phase === 'TEAM_BUILDING'}}">
          <view class="gold">
            {{isLeader ? '请选择任务成员' : '队长正在选择任务成员'}}
          </view>
          <view class="muted">本轮需要 {{game.requiredTeamSize}} 人</view>
          <view class="good small">已选：{{selectedText || '暂无'}}</view>
        </block>
        <block wx:elif="{{game.phase === 'TEAM_VOTING'}}">
          <view class="gold">是否同意这支队伍？</view>
          <view class="muted small">队伍：{{selectedText}}</view>
          <view class="muted small">
            {{game.hasVoted ? '已投票，等待其他玩家' : '请投票'}}
          </view>
        </block>
        <block wx:elif="{{game.phase === 'MISSION_EXECUTING'}}">
          <view class="gold">任务执行中</view>
          <view class="muted small">{{!game.onMission ? '等待任务成员完成' : game.hasSubmittedMission ? '已完成任务，等待其他任务成员' : '请做任务'}}</view>
        </block>
        <block wx:elif="{{game.phase === 'ASSASSINATION'}}">
          <view class="gold">
            {{game.assassin ? '刺杀梅林' : '刺客正在寻找梅林'}}
          </view>
          <view wx:if="{{game.assassin}}" class="muted small">请选择你认为是梅林的玩家</view>
          <view wx:if="{{game.assassin && targetName}}" class="evil small">已选择：{{selectedText}}号 {{targetName}}</view>
          <view class="muted small">确认后不可更改</view>
        </block>
        <block wx:elif="{{game.phase === 'LADY_OF_LAKE'}}">
          <view class="gold">湖中仙女</view>
          <view class="muted small">{{game.ladyHolder ? '请选择检查目标' : '等待持有者操作'}}</view>
        </block>
        <block wx:else>
          <view class="gold">第 {{game.missionNo}} 轮</view>
          <view class="muted small">保持交流，等待当前操作完成</view>
        </block>
      </view>
    </view>
    <block wx:if="{{game.phase === 'LADY_OF_LAKE'}}">
      <view class="card">
        <view class="gold">当前持有者：{{game.ladyHolderNickname}}</view>
        <view class="muted small">
          第 {{game.missionNo}} 个任务结算后 · {{game.ladyHolder ?
          '选择从未持有过湖中仙女的玩家' : '等待持有者检查阵营'}}
        </view>
      </view>
      <view class="card">
        <view class="gold">
          {{game.ladyHolder ? (targetName ? '已选择：' + targetName :
          '请选择检查目标') : '检查结果仅持有者可见'}}
        </view>
        <view class="muted small">
          检查后自动传递 token；只得知 GOOD / EVIL，不会显示角色。
        </view>
      </view>
    </block>
    <game-log
      wx:if="{{board && game.phase !== 'ASSASSINATION' && entries.length}}"
      compact="{{true}}"
      gameId="{{game.gameId}}"
      maxMissionSlots="{{rule.maxMissionSlots}}"
      entries="{{entries}}"
    />
    <view class="phase-actions actions">
      <button
        wx:if="{{game.phase === 'TEAM_BUILDING'}}"
        class="btn"
        disabled="{{!isLeader || selectedIds.length !== game.requiredTeamSize || busy}}"
        bindtap="submitTeam"
      >
        {{isLeader ? '确认发车' : '等待队长选人'}}
      </button>
      <view wx:elif="{{game.phase === 'TEAM_VOTING'}}">
        <view wx:if="{{!game.hasVoted}}" class="two-buttons">
          <button class="btn success" disabled="{{busy}}" bindtap="approve">
            同意
          </button>
          <button class="btn danger" disabled="{{busy}}" bindtap="reject">
            反对
          </button>
        </view>
        <button wx:else class="btn" disabled="{{true}}">
          已投票，等待其他玩家
        </button>
      </view>
      <block wx:elif="{{game.phase === 'MISSION_EXECUTING'}}">
        <button
          wx:if="{{game.onMission && !game.hasSubmittedMission}}"
          class="btn ghost"
          disabled="{{busy}}"
          bindtap="openMissionOverlay"
        >
          {{viewVotes ? '返回秘密任务' : '执行秘密任务'}}
        </button>
        <button wx:else class="btn" disabled="{{true}}">
          {{game.hasSubmittedMission ? '已秘密提交 · 等待其他任务成员' : '等待任务成员提交'}}
        </button>
      </block>
      <button
        wx:elif="{{game.phase === 'LADY_OF_LAKE'}}"
        class="btn"
        disabled="{{!game.ladyHolder || !ladyTarget || busy}}"
        bindtap="inspectLady"
      >
        {{game.ladyHolder ? '确认检查并传递湖中仙女' : '等待持有者操作'}}
      </button>
      <button
        wx:elif="{{game.phase === 'ASSASSINATION'}}"
        class="btn danger"
        disabled="{{!game.assassin || !assassinationTarget || busy}}"
        bindtap="assassinate"
      >
        {{game.assassin ? '确认刺杀' + targetName : '等待刺客行动'}}
      </button>
      <view
        wx:if="{{game.phase === 'TEAM_BUILDING' || game.phase === 'TEAM_VOTING'}}"
        class="footer-note"
      >
        连续否决 {{game.consecutiveRejections}} / {{game.maxRejections}} ·
        {{game.leaderNickname}} 为当前队长
      </view>
    </view>
  </block>
  <mission-detail-overlay wx:if="{{missionDetail && !missionResultOpen}}" detail="{{missionDetail}}" bind:close="closeMissionDetail" />
  <mission-card-overlay
    wx:if="{{missionOverlayOpen && game.phase === 'MISSION_EXECUTING' && game.onMission && !game.hasSubmittedMission}}"
    evil="{{game.evil}}" teamSize="{{game.requiredTeamSize}}" choice="{{missionChoice}}" busy="{{busy}}"
    successCard="{{missionSuccessCard}}" failCard="{{missionFailCard}}" cardBack="{{missionCardBack}}"
    bind:success="missionSuccess" bind:fail="missionFail" bind:submit="submitMission"
    bind:close="closeMissionOverlay" bind:votes="toggleVotes"
  />
  <mission-result-overlay
    wx:if="{{missionResultOpen && missionResult}}" visible="{{missionResultOpen}}"
    missionNo="{{missionResult.missionNo}}" successCount="{{missionResult.successCount}}"
    failCount="{{missionResult.failCount}}" status="{{missionResult.status}}"
    successCard="{{missionSuccessCard}}" failCard="{{missionFailCard}}" cardBack="{{missionCardBack}}"
    bind:confirm="confirmMissionResult"
  />
  <view wx:if="{{roleOverlay && role}}" class="private-overlay" catchtap="ignoreTap">
    <view class="card private-result role-overlay-card">
      <view class="muted small">仅你可见</view>
      <view class="role-overlay-art">
        <play-card front="{{roleCardFront}}" back="{{roleCardBack}}" flipped="{{true}}"
          size="medium" interactive="{{false}}" />
      </view>
      <view class="{{role.alignmentCode === 'GOOD' ? 'good' : 'evil'}}">{{role.alignmentName}}</view>
      <view class="role-overlay-instruction">{{role.instruction}}</view>
      <view wx:if="{{role.visiblePlayers.length}}" class="role-overlay-vision">
        <view class="muted small">{{role.visiblePlayers[0].hint}}</view>
        <view wx:for="{{role.visiblePlayers}}" wx:key="playerId" class="role-overlay-player">
          <text>{{item.seatNo}}号 {{item.nickname}}</text>
          <text wx:if="{{item.markType === 'ROLE'}}">{{item.roleName}}</text>
          <view class="knowledge-inline {{item.knowledgeClass}}"><knowledge-mark type="{{item.knowledgeType}}" markType="{{item.markType}}" text="{{item.markText}}" tone="{{item.markClass}}" /></view>
        </view>
      </view>
      <view wx:else class="muted small">你没有额外角色视野</view>
      <button class="btn" bindtap="closeRoleOverlay">我已查看</button>
    </view>
  </view>
  <view wx:if="{{ladyResult}}" class="private-overlay">
    <view class="card private-result">
      <view class="muted small">湖中仙女结果（仅你可见）</view>
      <view
        class="{{ladyResult.alignment === 'GOOD' ? 'good' : 'evil'}} result-alignment"
      >
        {{ladyResult.targetNickname}} 属于：{{ladyResult.alignment}}
      </view>
      <view class="muted small">湖中仙女已传给该玩家，对局已自动推进。</view>
      <button class="btn" bindtap="dismissLady">我已知晓</button>
    </view>
  </view>
</view>
<view wx:else class="page">
  <page-head title="阿瓦隆" subtitle="正在进入房间…" />
  <view class="error" wx:if="{{error}}" bindtap="refresh">{{error}}</view>
</view>
