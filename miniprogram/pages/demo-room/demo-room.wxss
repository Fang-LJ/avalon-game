@import "../room/room.wxss";
@import "../../utils/guest-pages.wxss";
.demo-status-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; flex-wrap: wrap; }
.demo-status-row mission-track { flex: 0 0 auto; }
.demo-quick-actions { display: flex; align-items: center; gap: 10rpx; margin-left: auto; }
.quick-action, .history-trigger { display: flex; align-items: center; justify-content: center; min-height: 64rpx; margin: 0; padding: 8rpx 12rpx; color: var(--gold); background: var(--elevated); border: 1rpx solid var(--border); border-radius: 14rpx; font-size: 22rpx; line-height: 1.5; white-space: nowrap; }
.quick-action::after, .history-trigger::after { border: 0; }
.demo-status { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 16rpx 0; color: var(--muted); font-size: 23rpx; }
.demo-status text { flex: 1; min-width: 0; }
.demo-buttons { display: flex; gap: 20rpx; margin: 0; }
.demo-buttons .btn { flex: 1; min-width: 0; margin: 0; padding: 22rpx 14rpx; font-size: 25rpx; }
.demo-page.has-demo-actions { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.demo-page .phase-actions { position: fixed; left: 38rpx; right: 38rpx; bottom: 0; z-index: 20; margin: 0; padding: 18rpx 0 calc(16rpx + env(safe-area-inset-bottom)); background: var(--bg); }
.demo-page .private-overlay { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
@media (max-width: 350px) {
  .demo-status-row { gap: 8rpx; }
  .demo-quick-actions { gap: 6rpx; }
  .quick-action { padding: 6rpx 8rpx; font-size: 20rpx; }
}
.demo-identity { display: grid; grid-template-columns: 54rpx minmax(0, 1fr) max-content; gap: 14rpx; align-items: center; padding: 18rpx 0; font-size: 24rpx; }
.demo-identity image { width: 54rpx; height: 54rpx; border-radius: 50%; }
.result-summary { text-align: center; }
.result-summary .winner { font-size: 38rpx; }
.demo-role-card { height: 100%; }
.demo-role-art { display: flex; justify-content: center; padding: 20rpx 0; }
