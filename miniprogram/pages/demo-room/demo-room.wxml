<view class="page guest-page demo-page" wx:if="{{room}}">
  <guest-header title="体验玩法" subtitle="本地 5 人局 · 体验玩家与四名机器人" bind:back="exit" />
  <button class="demo-exit" style="top: {{exitTop}}px;" bindtap="exit">退出体验</button>
  <view class="demo-label">无需登录 · 不计入正式战绩</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{!game}}">
    <view class="guest-card"><view class="guest-heading">准备入座 · {{room.currentPlayers}} / 5</view><view class="guest-copy">{{hint}}</view></view>
    <view class="lobby-board demo-lobby">
      <view wx:for="{{displayPlayers}}" wx:key="seatNo" class="positioned-seat" style="{{item.position}}"><player-seat player="{{item}}" lobby="{{true}}" /></view>
      <view class="lobby-center"><view class="gold">阿瓦隆体验</view><view class="muted small">梅林 · 派西维尔 · 忠臣<br/>莫甘娜 · 刺客</view></view>
    </view>
    <view class="demo-buttons" wx:if="{{room.currentPlayers < 5}}"><button class="btn ghost" bindtap="addBot">添加一个机器人</button><button class="btn" bindtap="fillBots">一键加入{{5 - room.currentPlayers}}名机器人</button></view>
    <button class="btn" disabled="{{room.currentPlayers !== 5}}" bindtap="start">{{room.currentPlayers === 5 ? '开始游戏' : '等待五人入座'}}</button>
  </block>
  <block wx:elif="{{game.phase === 'ROLE_CONFIRM'}}"><card-deal-stage gameId="{{game.gameId}}" role="{{role}}" busy="{{false}}" bind:confirm="confirmRole" /><view class="guest-note">机器人会自动确认身份。你只会看到自己的身份与合法视野。</view><view class="demo-tools"><button bindtap="restart">重新开始</button><button bindtap="end">结束本局</button></view></block>
  <block wx:elif="{{game.phase === 'FINISHED'}}">
    <view class="guest-card result-summary"><view class="winner {{game.winner === 'EVIL' ? 'guest-evil' : 'guest-good'}}">{{game.winner ? (game.winner === 'GOOD' ? '正义阵营获胜' : '邪恶阵营获胜') : '体验已结束'}}</view><view class="guest-copy">{{reasonText}}</view><view class="guest-note">任务成功 {{game.goodScore}} 次 · 失败 {{game.evilScore}} 次</view></view>
    <view wx:for="{{finishedGroups}}" wx:key="alignment" class="guest-card {{item.tone}}"><view class="guest-heading">{{item.title}}</view><view wx:for="{{item.players}}" wx:for-item="player" wx:key="playerId" class="demo-identity"><image src="{{player.avatarUrl}}" mode="aspectFill" /><text>{{player.seatNo}}号 {{player.nickname}}</text><text class="gold">{{player.roleName}}</text></view></view>
    <game-log wx:if="{{entries.length}}" entries="{{entries}}" gameId="{{game.gameId}}" compact="{{false}}" replay="{{false}}" />
    <button class="btn guest-back" bindtap="restart">再来一局</button><button class="btn ghost" bindtap="exit">退出体验</button>
  </block>
  <block wx:else>
    <view class="demo-status"><view class="guest-heading">{{phaseTitle}}</view><view class="guest-copy">{{hint}}</view><view class="guest-note">第 {{game.missionNo}} 轮 · 第 {{game.proposalNo}} 次组队</view></view>
    <mission-track missions="{{missions}}" current="{{game.missionNo}}" teamSizes="{{rule.teamSizes}}" />
    <view class="board">
      <view wx:for="{{displayPlayers}}" wx:key="seatNo" class="positioned-seat" style="{{item.position}}"><player-seat player="{{item}}" formal="{{true}}" hideNickname="{{true}}" bind:select="selectSeat" /></view>
      <view class="board-center"><view>{{game.phase === 'ASSASSINATION' ? '刺杀梅林' : '队伍 ' + game.requiredTeamSize + ' 人'}}</view><view>成功 {{game.goodScore}} · 失败 {{game.evilScore}}</view><view class="gold">{{selectedText || '等待选择'}}</view><view wx:if="{{game.phase !== 'ASSASSINATION'}}" class="rejection-status"><text class="rejection-label">否决</text><view wx:for="{{rejection.dots}}" wx:key="index" class="rejection-dot {{item ? 'rejected' : ''}}"></view></view></view>
    </view>
    <view class="phase-actions">
      <button wx:if="{{game.phase === 'TEAM_BUILDING'}}" class="btn" disabled="{{!isLeader || selectedIds.length !== game.requiredTeamSize}}" bindtap="submitTeam">{{isLeader ? '提交任务队伍' : '等待机器人队长'}}</button>
      <view wx:elif="{{game.phase === 'TEAM_VOTING'}}" class="demo-buttons"><button class="btn" disabled="{{game.hasVoted}}" bindtap="approve">赞成</button><button class="btn ghost" disabled="{{game.hasVoted}}" bindtap="reject">反对</button></view>
      <button wx:elif="{{game.phase === 'MISSION_EXECUTING'}}" class="btn" disabled="{{!game.onMission || game.hasSubmittedMission}}" bindtap="openMission">{{game.onMission ? (game.hasSubmittedMission ? '已秘密提交' : '选择任务牌') : '等待机器人执行任务'}}</button>
      <button wx:elif="{{game.phase === 'ASSASSINATION'}}" class="btn danger" disabled="{{!game.assassin || !targetId}}" bindtap="assassinate">{{game.assassin ? '确认刺杀' + (targetName ? ' · ' + targetName : '') : '等待机器人刺客'}}</button>
    </view>
    <view class="demo-tools"><button bindtap="openRole">我的身份</button><button bindtap="toggleVotes">{{viewVotes ? '收起对局记录' : '对局记录'}}</button></view>
    <game-log wx:if="{{viewVotes && entries.length}}" entries="{{entries}}" compact="{{false}}" replay="{{false}}" gameId="{{game.gameId}}" />
    <view wx:if="{{viewVotes && !entries.length}}" class="guest-note">表决结束后，在这里查看公开投票和任务结果。</view>
    <button wx:if="{{game.assassin && game.phase !== 'ASSASSINATION'}}" class="btn ghost guest-back" bindtap="earlyAssassination">提前发动刺杀</button>
    <view class="demo-tools"><button bindtap="restart">重新开始</button><button bindtap="end">结束本局</button></view>
  </block>
  <mission-card-overlay wx:if="{{missionOverlayOpen && game.phase === 'MISSION_EXECUTING' && !game.hasSubmittedMission}}" evil="{{game.evil}}" teamSize="{{game.requiredTeamSize}}" choice="{{missionChoice}}" busy="{{false}}" successCard="{{cards.actions.SUCCESS}}" failCard="{{cards.actions.FAIL}}" cardBack="{{cards.back.ACTION}}" bind:success="missionSuccess" bind:fail="missionFail" bind:submit="submitMission" bind:close="closeMission" bind:votes="toggleVotes" />
  <mission-result-overlay wx:if="{{missionResultOpen && missionResult}}" visible="{{true}}" missionNo="{{missionResult.missionNo}}" successCount="{{missionResult.successCount}}" failCount="{{missionResult.failCount}}" status="{{missionResult.status}}" bind:confirm="confirmResult" />
  <view wx:if="{{roleOverlay}}" class="private-overlay" catchtap="ignoreTap"><scroll-view scroll-y="{{true}}" class="card demo-role-card"><view class="muted small">仅你可见</view><view class="demo-role-art"><play-card front="{{roleCardFront}}" back="{{roleCardBack}}" flipped="{{true}}" size="medium" interactive="{{false}}" /></view><view class="guest-copy">{{role.instruction}}</view><view wx:for="{{role.visiblePlayers}}" wx:key="playerId" class="role-overlay-player"><text>{{item.seatNo}}号 {{item.nickname}}</text><text wx:if="{{item.roleName}}">{{item.roleName}}</text><view class="knowledge-inline"><knowledge-mark type="{{item.knowledgeType}}" markType="{{item.markType}}" text="{{item.markText}}" tone="{{item.markClass}}" /></view></view><view wx:if="{{!role.visiblePlayers.length}}" class="guest-note">你没有额外角色视野</view><button class="btn guest-back" bindtap="closeRole">我已查看</button></scroll-view></view>
</view>
