<view class="page guest-page demo-page {{game && game.phase !== 'ROLE_CONFIRM' && game.phase !== 'FINISHED' ? 'has-demo-actions' : ''}}" wx:if="{{room}}">
  <guest-header title="{{game.phase === 'ROLE_CONFIRM' ? '' : game.phase === 'FINISHED' ? '对局结束' : '第 ' + game.missionNo + ' 轮 · ' + phaseTitle}}" bind:back="exit" />
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{game.phase === 'ROLE_CONFIRM'}}">
    <card-deal-stage gameId="{{game.gameId}}" role="{{role}}" busy="{{false}}" bind:confirm="confirmRole" />
  </block>
  <block wx:elif="{{game.phase === 'FINISHED'}}">
    <view class="guest-card result-summary"><view class="winner {{game.winner === 'EVIL' ? 'guest-evil' : 'guest-good'}}">{{game.winner ? (game.winner === 'GOOD' ? '正义阵营获胜' : '邪恶阵营获胜') : '体验已结束'}}</view><view class="guest-copy">{{reasonText}}</view><view class="guest-note">任务成功 {{game.goodScore}} 次 · 失败 {{game.evilScore}} 次</view></view>
    <view wx:for="{{finishedGroups}}" wx:key="alignment" class="guest-card {{item.tone}}"><view class="guest-heading">{{item.title}}</view><view wx:for="{{item.players}}" wx:for-item="player" wx:key="playerId" class="demo-identity"><image src="{{player.avatarUrl}}" mode="aspectFill" /><text>{{player.seatNo}}号 {{player.nickname}}</text><text class="gold">{{player.roleName}}</text></view></view>
    <game-log wx:if="{{entries.length}}" entries="{{entries}}" gameId="{{game.gameId}}" compact="{{false}}" replay="{{false}}" />
    <button class="btn guest-back" bindtap="restart">再来一局</button><button class="btn ghost" bindtap="exit">返回主页</button>
  </block>
  <block wx:else>
    <view class="demo-status-row">
      <mission-track missions="{{missions}}" current="{{game.missionNo}}" teamSizes="{{rule.teamSizes}}" bind:missiontap="openHistory" />
      <view class="demo-quick-actions">
        <button wx:if="{{canEarlyAssassination}}" class="quick-action" bindtap="earlyAssassination">刺杀</button>
        <button class="quick-action demo-role-trigger" bindtap="openRole">我的身份</button>
      </view>
    </view>
    <view class="demo-status"><text>{{hint}}</text><button class="history-trigger" bindtap="toggleVotes">{{viewVotes ? '收起记录' : '记录'}}</button></view>
    <block wx:if="{{viewVotes}}">
      <game-log wx:if="{{entries.length}}" entries="{{entries}}" compact="{{false}}" replay="{{false}}" gameId="{{game.gameId}}" />
      <view wx:else class="guest-note">暂无已完成的表决或任务</view>
    </block>
    <view class="board">
      <view wx:for="{{displayPlayers}}" wx:key="seatNo" class="positioned-seat" style="{{item.position}}"><player-seat player="{{item}}" formal="{{true}}" hideNickname="{{true}}" bind:select="selectSeat" /></view>
      <view class="board-center"><view>{{game.phase === 'ASSASSINATION' ? '刺杀梅林' : '队伍 ' + game.requiredTeamSize + ' 人'}}</view><view>成功 {{game.goodScore}} · 失败 {{game.evilScore}}</view><view class="gold">{{selectedText || '等待选择'}}</view><view wx:if="{{game.phase !== 'ASSASSINATION'}}" class="rejection-status"><text class="rejection-label">否决</text><view wx:for="{{rejection.dots}}" wx:key="index" class="rejection-dot {{item ? 'rejected' : ''}}"></view></view></view>
    </view>
    <view class="phase-actions">
      <button wx:if="{{game.phase === 'TEAM_BUILDING'}}" class="btn" disabled="{{!isLeader || selectedIds.length !== game.requiredTeamSize}}" bindtap="submitTeam">{{isLeader ? '确认发车' : '等待队长选人'}}</button>
      <view wx:elif="{{game.phase === 'TEAM_VOTING'}}" class="demo-buttons"><button class="btn" disabled="{{game.hasVoted}}" bindtap="approve">赞成</button><button class="btn ghost" disabled="{{game.hasVoted}}" bindtap="reject">反对</button></view>
      <button wx:elif="{{game.phase === 'MISSION_EXECUTING'}}" class="btn" disabled="{{!game.onMission || game.hasSubmittedMission}}" bindtap="openMission">{{game.onMission ? (game.hasSubmittedMission ? '已秘密提交' : '执行任务') : '等待任务成员提交'}}</button>
      <button wx:elif="{{game.phase === 'ASSASSINATION'}}" class="btn danger" disabled="{{!game.assassin || !targetId}}" bindtap="assassinate">{{game.assassin ? '确认刺杀' + (targetName ? ' · ' + targetName : '') : '等待刺客行动'}}</button>
    </view>
  </block>
  <mission-card-overlay wx:if="{{missionOverlayOpen && game.phase === 'MISSION_EXECUTING' && !game.hasSubmittedMission}}" evil="{{game.evil}}" teamSize="{{game.requiredTeamSize}}" choice="{{missionChoice}}" busy="{{false}}" successCard="{{cards.actions.SUCCESS}}" failCard="{{cards.actions.FAIL}}" cardBack="{{cards.back.ACTION}}" bind:success="missionSuccess" bind:fail="missionFail" bind:submit="submitMission" bind:close="closeMission" bind:votes="toggleVotes" />
  <mission-result-overlay wx:if="{{missionResultOpen && missionResult}}" visible="{{true}}" missionNo="{{missionResult.missionNo}}" successCount="{{missionResult.successCount}}" failCount="{{missionResult.failCount}}" status="{{missionResult.status}}" bind:confirm="confirmResult" />
  <view wx:if="{{roleOverlay}}" class="private-overlay" style="padding-top: {{overlayTop}}px;" catchtap="ignoreTap"><scroll-view scroll-y="{{true}}" class="card demo-role-card"><view class="muted small">仅你可见</view><view class="demo-role-art"><play-card front="{{roleCardFront}}" back="{{roleCardBack}}" flipped="{{true}}" size="medium" interactive="{{false}}" /></view><view class="guest-copy">{{role.instruction}}</view><view wx:for="{{role.visiblePlayers}}" wx:key="playerId" class="role-overlay-player"><text class="vision-seat">{{item.seatNo}}号</text><text class="vision-nickname">{{item.nickname}}</text><text wx:if="{{item.markType}}" class="vision-label {{item.markType === 'MERLIN_OR_MORGANA' ? 'vision-label-candidate' : 'vision-label-evil'}}">{{item.markType === 'ROLE' ? item.roleName : item.markType === 'EVIL' ? '红方' : '?'}}</text></view><view wx:if="{{!role.visiblePlayers.length}}" class="guest-note">你没有额外角色视野</view><button class="btn guest-back demo-role-close" bindtap="closeRole">我已查看</button></scroll-view></view>
</view>
