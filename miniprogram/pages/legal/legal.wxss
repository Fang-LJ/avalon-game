@import "../../utils/guest-pages.wxss";
.legal-page guest-header { color: var(--gold); }
.legal-metadata { color: var(--muted); font-size: 23rpx; line-height: 1.8; margin: 0 0 28rpx; }
.legal-block { margin-top: 18rpx; font-size: 25rpx; line-height: 1.85; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
.legal-subheading { color: var(--gold); font-size: 27rpx; font-weight: 700; margin-top: 26rpx; }
.legal-bullet { padding-left: 12rpx; }
