:host {
  display: block;
}
.tab-bar {
  position: fixed;
  z-index: 20;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: var(--elevated);
  padding: 21rpx 0 calc(15rpx + env(safe-area-inset-bottom));
}
.tab {
  flex: 1;
  text-align: center;
  color: var(--muted);
  font-size: 21rpx;
}
.tab.active {
  color: var(--gold);
}
.tab-icon {
  font-size: 35rpx;
  line-height: 50rpx;
  margin-bottom: 6rpx;
}

.v3-tab-bar { padding: 0 0 max(15px, env(safe-area-inset-bottom)); background: var(--elevated); }
.v3-tab-bar .tab { position: relative; display: flex; flex-direction: column; align-items: center; height: 63px; padding-top: 16px; color: var(--muted); font-size: 12px; font-weight: 400; line-height: 17px; }
.v3-tab-bar .tab.active { color: var(--gold); font-weight: 700; }
.v3-tab-icon { display: block; width: 22px; height: 22px; flex-shrink: 0; margin-bottom: 8px; }
.tab-indicator { position: absolute; top: 7px; left: 50%; width: 28px; height: 3px; border-radius: 2px; transform: translateX(-50%); background: var(--gold); }

/* The retained profile tab assets have 20px intrinsic bounds. */
.v3-tab-bar.me-icons .v3-tab-icon { width: 20px; height: 20px; margin-bottom: 10px; }
