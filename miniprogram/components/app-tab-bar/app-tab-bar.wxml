<view class="tab-bar {{v3 ? 'v3-tab-bar' : ''}}">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab {{active === item.key ? 'active' : ''}}"
    data-key="{{item.key}}"
    bindtap="open"
  >
    <view wx:if="{{v3 && active === item.key}}" class="tab-indicator"></view>
    <image wx:if="{{v3}}" class="v3-tab-icon" src="/assets/ui-v3/{{v3Icons[active][item.key]}}.svg" aria-hidden="{{true}}" />
    <view wx:else class="tab-icon">{{item.icon}}</view>
    <view>{{item.label}}</view>
  </view>
</view>
