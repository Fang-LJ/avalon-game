<view wx:if="{{sheet}}" class="guess-mask" catchtap="close" catchtouchmove="ignoreTap">
  <view class="guess-sheet" catchtap="ignoreTap">
    <view class="guess-title">标注身份</view>
    <view class="guess-options">
      <button wx:for="{{sheet.options}}" wx:key="roleCode" class="guess-option {{item.tone}} {{sheet.currentRole === item.roleCode ? 'chosen' : ''}}" data-role-code="{{item.roleCode}}" bindtap="choose">{{item.name}}</button>
    </view>
    <view class="guess-note">再次点击已选身份即可取消标注</view>
  </view>
</view>
