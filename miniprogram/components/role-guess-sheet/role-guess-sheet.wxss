:host { display: block; }
.guess-mask { position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,.78); display: flex; align-items: center; justify-content: center; }
.guess-sheet { width: 84%; max-width: 640rpx; max-height: 82vh; overflow-y: auto; background: var(--elevated); border: 1rpx solid var(--border); border-radius: 30rpx; padding: 32rpx; box-sizing: border-box; }
.guess-title { color: var(--text); font-size: 32rpx; font-weight: 800; line-height: 44rpx; text-align: center; }
.guess-options { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; margin-top: 26rpx; }
.guess-option { min-width: 0; margin: 0; padding: 0 8rpx; height: 78rpx; line-height: 78rpx; font-size: 26rpx; border: 1rpx solid; border-radius: 16rpx; white-space: nowrap; }
.guess-option::after { border: 0; }
.guess-option.good { color: #78B7FF; background: rgba(75,134,198,.10); border-color: rgba(75,134,198,.50); }
.guess-option.evil { color: #E88A94; background: rgba(201,93,104,.10); border-color: rgba(232,138,148,.45); }
.guess-option.good.chosen { background: rgba(75,134,198,.28); border-color: #78B7FF; box-shadow: 0 0 10rpx rgba(120,183,255,.15); }
.guess-option.evil.chosen { background: rgba(201,93,104,.26); border-color: #E88A94; box-shadow: 0 0 10rpx rgba(232,138,148,.15); }
.guess-note { color: var(--muted); font-size: 21rpx; line-height: 30rpx; margin-top: 24rpx; text-align: center; }
