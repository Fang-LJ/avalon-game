:host {
  display: block;
}
.seat {
  width: 146rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
}
.seat-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: var(--soft);
  border: 1px solid var(--border);
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 700;
  overflow: visible;
}
.seat-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.empty-avatar {
  border-style: dashed;
  color: var(--gold);
  font-size: 46rpx;
}
.seat-name {
  max-width: 146rpx;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.seat-number {
  color: var(--text);
  font-size: 24rpx;
  font-weight: 700;
}
.formal .seat-number {
  font-size: 28rpx;
}
.formal .seat-name {
  color: var(--muted);
  font-size: 18rpx;
}
.seat-empty-label {
  color: var(--muted);
  font-size: 18rpx;
}
.seat-badge {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border: 2px solid var(--bg);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}
.leader-icon {
  top: -11rpx;
  left: 50%;
  transform: translateX(-50%);
  color: var(--bg);
  background: var(--gold);
}
.selected-icon {
  top: -5rpx;
  right: -5rpx;
  color: var(--bg);
  background: var(--good);
}
.knowledge-icon {
  right: -5rpx;
  bottom: -5rpx;
}
.knowledge-evil {
  color: var(--text);
  background: var(--evil);
}
.knowledge-candidate {
  color: var(--bg);
  background: var(--gold);
}
.me-icon {
  bottom: -5rpx;
  left: -5rpx;
  color: var(--text);
  background: var(--accent);
}
.badges {
  display: flex;
  gap: 4rpx;
  min-height: 30rpx;
}
.badge {
  border-radius: 999rpx;
  font-size: 17rpx;
  padding: 2rpx 8rpx;
}
.leader-badge {
  background: var(--gold);
  color: var(--bg);
}
.selected-badge {
  background: var(--good);
  color: var(--bg);
}
.me-badge {
  background: var(--accent);
}
.disabled {
  opacity: 0.4;
}
.compact {
  width: 125rpx;
}
.compact .seat-avatar {
  width: 100rpx;
  height: 100rpx;
}
.compact .seat-name {
  max-width: 125rpx;
  font-size: 21rpx;
}
