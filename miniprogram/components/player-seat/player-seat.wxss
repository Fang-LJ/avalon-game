:host {
  display: block;
}
.seat {
  width: 146rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
}
.seat-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: var(--soft);
  border: 1px solid var(--border);
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 700;
  overflow: hidden;
}
.seat-avatar image {
  width: 100%;
  height: 100%;
}
.seat-avatar.me {
  border: 2px solid var(--accent);
}
.seat-avatar.selected {
  border: 2px solid var(--good);
}
.seat-avatar.leader {
  box-shadow: 0 0 0 2px var(--gold);
}
.seat-name {
  max-width: 146rpx;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.badges {
  display: flex;
  gap: 4rpx;
  min-height: 30rpx;
}
.badge {
  border-radius: 999rpx;
  font-size: 17rpx;
  padding: 2rpx 8rpx;
}
.leader-badge {
  background: var(--gold);
  color: var(--bg);
}
.selected-badge {
  background: var(--good);
  color: var(--bg);
}
.me-badge {
  background: var(--accent);
}
.disabled {
  opacity: 0.4;
}
.compact {
  width: 125rpx;
}
.compact .seat-avatar {
  width: 100rpx;
  height: 100rpx;
}
.compact .seat-name {
  max-width: 125rpx;
  font-size: 21rpx;
}
