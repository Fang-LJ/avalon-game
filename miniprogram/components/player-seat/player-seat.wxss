:host {
  display: block;
}
.seat {
  width: 146rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
}
.seat-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: var(--soft);
  border: 1px solid var(--border);
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 700;
  overflow: visible;
}
.seat-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.empty-avatar {
  border-style: dashed;
  color: var(--gold);
  font-size: 46rpx;
}

.seat-empty-label {
  color: var(--muted);
  font-size: 18rpx;
}
.seat-badge {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border: 2px solid var(--bg);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}
.leader-icon {
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  color: var(--bg);
  background: var(--gold);
  width: 42rpx;
  height: 42rpx;
  font-size: 26rpx;
  padding: 0;
}
.selected-team { box-shadow: 0 0 0 4rpx var(--bg), 0 0 0 8rpx var(--selection); }
.selected-assassination { box-shadow: 0 0 0 4rpx var(--bg), 0 0 0 9rpx #FFD166, 0 0 18rpx rgba(255, 209, 102, .30); }
.revealed-evil-ring { box-shadow: 0 0 0 4rpx var(--bg), 0 0 0 8rpx #C85C68, 0 0 14rpx rgba(200, 92, 104, .22); }
.selected-lady { box-shadow: 0 0 0 4rpx var(--bg), 0 0 0 8rpx var(--gold); }
.knowledge-icon {
  --identity-mark-size: 38rpx;
  --identity-mark-font-size: 22rpx;
  --identity-mark-padding: 9rpx;
  --guess-question-font-size: 20rpx;
  left: calc(100% - 33rpx);
  bottom: -5rpx;
  width: auto;
  min-width: 38rpx;
  height: 38rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  display: block;
  overflow: visible;
}
.action-done-icon {
  top: -5rpx;
  right: -5rpx;
  width: 30rpx;
  padding: 0;
  color: var(--bg);
  background: var(--good);
}
.knowledge-evil {
  background: transparent;
}
.knowledge-candidate {
  background: transparent;
}
.me-icon {
  bottom: -5rpx;
  left: -5rpx;
  color: var(--text);
  background: var(--accent);
}
.badges {
  display: flex;
  gap: 4rpx;
  min-height: 30rpx;
}
.badge {
  border-radius: 999rpx;
  font-size: 17rpx;
  padding: 2rpx 8rpx;
}
.leader-badge {
  background: var(--gold);
  color: var(--bg);
}
.selected-badge {
  background: var(--good);
  color: var(--bg);
}
.me-badge {
  background: var(--accent);
}
.disabled {
  opacity: 0.4;
}
.compact {
  width: 125rpx;
}
.compact .seat-avatar {
  width: 100rpx;
  height: 100rpx;
}

.formal { width: 128rpx; gap: 4rpx; }
.formal .seat-avatar { width: 96rpx; height: 96rpx; }

.formal.compact { width: 112rpx; }
.formal.compact .seat-avatar { width: 84rpx; height: 84rpx; }
.formal.compact .action-done-icon { right: -9rpx; }
.formal.compact .leader-icon { width: 36rpx; height: 36rpx; font-size: 23rpx; }
.compact .knowledge-icon { --identity-mark-size: 34rpx; --identity-mark-font-size: 20rpx; --identity-mark-padding: 8rpx; --guess-question-font-size: 18rpx; left: calc(100% - 29rpx); width: auto; min-width: 34rpx; height: 34rpx; }

.seat-caption { margin-top: 8rpx; display: flex; align-items: baseline; justify-content: center; width: 104rpx; min-width: 0; font-size: 25rpx; line-height: 34rpx; white-space: nowrap; }
.seat-number { flex-shrink: 0; color: var(--gold); font-weight: 700; }
.seat-divider { flex-shrink: 0; margin: 0 5rpx; color: var(--muted); }
.seat-name { min-width: 0; overflow: hidden; text-overflow: clip; white-space: nowrap; color: var(--text); }
.dense .seat-caption { font-size: 24rpx; line-height: 32rpx; }
.compact .seat-caption { font-size: 21rpx; line-height: 30rpx; }

.formal .seat-caption { max-width: 104rpx; }
