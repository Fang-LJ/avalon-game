:host {
  display: block;
}
.seat {
  width: 146rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
}
.seat-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: var(--soft);
  border: 1px solid var(--border);
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 700;
  overflow: visible;
}
.seat-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.empty-avatar {
  border-style: dashed;
  color: var(--gold);
  font-size: 46rpx;
}
.seat-name {
  max-width: 146rpx;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.seat-number {
  color: var(--text);
  font-size: 24rpx;
  font-weight: 700;
}
.formal .seat-number {
  font-size: 28rpx;
}
.formal .seat-name {
  color: var(--muted);
  font-size: 18rpx;
}
.seat-empty-label {
  color: var(--muted);
  font-size: 18rpx;
}
.seat-badge {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border: 2px solid var(--bg);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}
.leader-icon {
  top: -11rpx;
  left: 50%;
  transform: translateX(-50%);
  color: var(--bg);
  background: var(--gold);
  width: 30rpx;
  padding: 0;
}
.selected-team { box-shadow: 0 0 0 4rpx var(--bg), 0 0 0 8rpx var(--selection); }
.selected-danger { box-shadow: 0 0 0 4rpx var(--bg), 0 0 0 8rpx var(--evil); }
.selected-lady { box-shadow: 0 0 0 4rpx var(--bg), 0 0 0 8rpx var(--gold); }
.knowledge-icon {
  right: -5rpx;
  bottom: -5rpx;
  width: 30rpx;
  padding: 0;
}
.action-done-icon {
  top: -5rpx;
  right: -5rpx;
  width: 30rpx;
  padding: 0;
  color: var(--bg);
  background: var(--good);
}
.knowledge-evil {
  background: transparent;
}
.knowledge-candidate {
  color: var(--bg);
  background: var(--gold);
}
.me-icon {
  bottom: -5rpx;
  left: -5rpx;
  color: var(--text);
  background: var(--accent);
}
.badges {
  display: flex;
  gap: 4rpx;
  min-height: 30rpx;
}
.badge {
  border-radius: 999rpx;
  font-size: 17rpx;
  padding: 2rpx 8rpx;
}
.leader-badge {
  background: var(--gold);
  color: var(--bg);
}
.selected-badge {
  background: var(--good);
  color: var(--bg);
}
.me-badge {
  background: var(--accent);
}
.disabled {
  opacity: 0.4;
}
.compact {
  width: 125rpx;
}
.compact .seat-avatar {
  width: 100rpx;
  height: 100rpx;
}
.compact .seat-name {
  max-width: 125rpx;
  font-size: 21rpx;
}
.seat-bot { font-size: 18rpx; line-height: 22rpx; color: var(--gold); }
.formal { width: 128rpx; gap: 4rpx; }
.formal .seat-avatar { width: 96rpx; height: 96rpx; }
.formal .seat-number { font-size: 26rpx; line-height: 34rpx; }
.formal .seat-name { max-width: 128rpx; font-size: 18rpx; line-height: 24rpx; }
.formal.compact { width: 112rpx; }
.formal.compact .seat-avatar { width: 84rpx; height: 84rpx; }
.formal.compact .action-done-icon { right: -9rpx; }
.formal.compact .seat-number { font-size: 24rpx; line-height: 32rpx; }
