<view
  class="seat {{compact ? 'compact' : ''}} {{formal ? 'formal' : ''}} {{dense ? 'dense' : ''}} {{player.empty ? 'empty-seat' : ''}} {{player.disabled ? 'disabled' : ''}}"
  bindtap="choose"
  bindtouchstart="beginTouch"
>
  <view
    class="seat-avatar {{player.empty ? 'empty-avatar' : ''}} {{player.revealedEvil ? 'revealed-evil-ring' : ''}} {{player.selected ? player.selectionClass : ''}}"
    bindlongpress="longPress"
  >
    <image
      wx:if="{{player.avatarUrl}}"
      src="{{player.avatarUrl}}"
      mode="aspectFill"
    />
    <text wx:else>{{player.initial}}</text>
    <text wx:if="{{player.leader}}" class="seat-badge leader-icon">♛</text>
    <text wx:if="{{player.actionDone}}" class="seat-badge action-done-icon">✓</text>
    <view wx:if="{{player.markType || player.knowledgeType}}" class="seat-badge knowledge-icon {{player.knowledgeClass}}"><knowledge-mark type="{{player.knowledgeType}}" markType="{{player.markType}}" text="{{player.markText}}" tone="{{player.markClass}}" /></view>
    <text wx:if="{{player.me}}" class="seat-badge me-icon">我</text>
  </view>
  <view class="seat-caption">
    <text class="seat-number">{{player.seatNo}}</text>
    <text class="seat-divider">·</text>
    <text class="seat-name">{{player.empty ? '空座' : player.nickname}}</text>
  </view>
  <view class="badges" wx:if="{{lobby && !player.empty && player.host}}">
    <text class="badge leader-badge">房主</text>
  </view>
</view>
