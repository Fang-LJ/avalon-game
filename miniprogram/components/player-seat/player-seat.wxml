<view
  class="seat {{compact ? 'compact' : ''}} {{formal ? 'formal' : ''}} {{player.empty ? 'empty-seat' : ''}} {{player.disabled ? 'disabled' : ''}}"
  bindtap="choose"
>
  <view
    class="seat-avatar {{player.empty ? 'empty-avatar' : ''}} {{player.selected ? player.selectionClass : ''}}"
  >
    <image
      wx:if="{{player.avatarUrl}}"
      src="{{player.avatarUrl}}"
      mode="aspectFill"
    />
    <text wx:else>{{player.initial}}</text>
    <text wx:if="{{player.leader}}" class="seat-badge leader-icon">♛</text>
    <text wx:if="{{player.actionDone}}" class="seat-badge action-done-icon">✓</text>
    <text wx:if="{{player.knowledgeType}}" class="seat-badge knowledge-icon {{player.knowledgeClass}}">{{player.knowledgeSymbol}}</text>
    <text wx:if="{{player.me}}" class="seat-badge me-icon">我</text>
  </view>
  <view class="seat-number">{{player.seatNo}}号位</view>
  <view wx:if="{{player.isBot}}" class="seat-bot">机器人</view>
  <view wx:if="{{!player.empty && !hideNickname}}" class="seat-name">
    {{player.nickname}}
  </view>
  <view wx:if="{{player.empty}}" class="seat-empty-label">空座</view>
  <view class="badges" wx:if="{{lobby && !player.empty && player.host}}">
    <text class="badge leader-badge">房主</text>
  </view>
</view>
