:host {
  display: block;
}
.log-entry {
  margin-bottom: 22rpx;
}
.log-title {
  font-size: 25rpx;
  font-weight: 700;
}
.lady-log {
  border-top: 1px solid var(--border);
  padding-top: 16rpx;
}
.live-proposal { display: flex; flex-direction: column; height: 296rpx; padding: 20rpx; box-sizing: border-box; }
.compact-entry { height: 100%; margin: 0; }
.live-proposal .log-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: 26rpx; line-height: 36rpx; white-space: nowrap; }
.proposal-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; flex-shrink: 0; }
.proposal-status { flex-shrink: 0; font-size: 20rpx; line-height: 28rpx; padding: 4rpx 12rpx; border: 1px solid; border-radius: 999rpx; white-space: nowrap; }
.proposal-status.approved { color: var(--good); background: rgba(70,194,163,.12); border-color: rgba(70,194,163,.4); }
.proposal-status.rejected { color: var(--evil); background: rgba(201,93,104,.12); border-color: rgba(201,93,104,.4); }
.proposal-info-grid { display: grid; grid-template-columns: 54rpx minmax(0, 1fr) 54rpx minmax(0, 1.25fr); column-gap: 8rpx; row-gap: 8rpx; align-items: center; font-size: 24rpx; line-height: 34rpx; flex-shrink: 0; }
.live-proposal > .proposal-info-grid { margin-top: 12rpx; }
.proposal-label { color: var(--muted); white-space: nowrap; text-align: left; }
.proposal-value { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.proposal-mission { display: flex; align-items: center; gap: 12rpx; height: 88rpx; box-sizing: content-box; border-top: 1px solid var(--border); padding-top: 12rpx; flex-shrink: 0; }
.live-proposal > .proposal-mission { margin-top: 12rpx; }
.mission-result-label { width: 116rpx; flex-shrink: 0; font-size: 23rpx; line-height: 34rpx; white-space: nowrap; }
.mission-slots { flex: 1; min-width: 0; display: grid; height: 88rpx; }
.slots-3 { grid-template-columns: repeat(3, 1fr); }
.slots-4 { grid-template-columns: repeat(4, 1fr); }
.slots-5 { grid-template-columns: repeat(5, 1fr); }
.mission-slot { display: flex; align-items: center; justify-content: center; min-width: 0; }
.mission-thumbnail { display: block; width: 62rpx; height: 86.18rpx; flex-shrink: 0; }
.log-leader { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-caption { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.history-swiper { height: 312rpx; }
.proposal-slide { height: 100%; box-sizing: border-box; padding: 8rpx 6rpx; transform: scale(.97); opacity: .78; transition: transform 250ms ease, opacity 250ms ease; }
.proposal-slide.active { transform: scale(1); opacity: 1; }
.proposal-slide .live-proposal { box-shadow: 0 4rpx 12rpx rgba(0,0,0,.12); }
.proposal-slide.active .live-proposal { box-shadow: 0 10rpx 26rpx rgba(0,0,0,.22); }
.all-history-link { padding: 16rpx 0; }
.history-overlay { position: fixed; inset: 0; z-index: 60; background: rgba(0,0,0,0.82); display: flex; align-items: flex-end; }
.history-sheet { width: 100%; height: 82vh; display: flex; flex-direction: column; background: var(--bg); border-radius: 28rpx 28rpx 0 0; border: 1px solid var(--border); padding: 24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.history-sheet-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex-shrink: 0; padding-bottom: 20rpx; }
.history-sheet-title { font-size: 30rpx; font-weight: 700; }
.history-close { flex-shrink: 0; margin: 0; padding: 0 16rpx; font-size: 25rpx; line-height: 88rpx; color: var(--gold); background: transparent; }
.history-close::after { border: 0; }
.history-scroll { flex: 1; min-height: 0; height: 0; }
.history-scroll-content { padding-bottom: 12rpx; }

/* Formal-room variant; replay and guest history retain their existing rendering. */
.night-proposal { height: 332rpx; padding: 20rpx 16rpx; background: rgba(13,27,21,.64); border: 1.5px solid var(--border); gap: 0; }
.night-proposal.result-rejected { border-color: var(--gold); }
.night-proposal.result-success { border-color: var(--good); }
.night-proposal.result-failed { border-color: var(--evil); }
.vote-cells { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4rpx; padding-top: 28rpx; margin-top: 4rpx; flex-shrink: 0; }
.vote-cell { position: relative; display: flex; align-items: center; justify-content: center; height: 60rpx; min-width: 0; box-sizing: border-box; border: 3rpx solid transparent; border-radius: 7rpx; font-size: 26rpx; font-weight: 700; color: #FFFFFF; background: #35453c; }
.vote-cell.vote-approve { background: #28785f; }
.vote-cell.vote-reject { background: #A93447; }
.vote-cell.vote-disabled { background: #303632; color: #7f8983; }
.vote-cell.on-team { border-color: #E6BF59; }
.vote-crown { position: absolute; top: -27rpx; left: 0; width: 100%; text-align: center; color: #E6BF59; font-size: 26rpx; line-height: 26rpx; }
.night-history-swiper { height: 348rpx; }
.night-history-swiper .proposal-slide { padding: 8rpx 2rpx; }
.night-proposal.compact-entry { height: 100%; }
.night-mission { display: flex; align-items: center; justify-content: center; flex: 1; min-height: 106rpx; margin-top: 14rpx; border-top: 1px solid rgba(216,178,92,.18); padding-top: 12rpx; }
.night-mission .mission-slots { flex: 1; max-width: 480rpx; height: 106rpx; }
.night-mission .mission-thumbnail { width: 76rpx; height: 105.64rpx; }
