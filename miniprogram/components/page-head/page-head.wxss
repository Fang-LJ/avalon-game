:host {
  display: block;
}
.page-head {
  padding-bottom: 43rpx;
}
.heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}
.title {
  max-width: 540rpx;
}
.subtitle {
  margin-top: 3rpx;
}
.compact-head { padding-bottom: 12rpx; }
.compact-head .heading-row { min-height: 44rpx; }
.compact-head .title { font-size: 32rpx; }
.compact-head .subtitle { font-size: 21rpx; }
