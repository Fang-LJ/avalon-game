:host {
  display: block;
}
.page-head {
  padding-bottom: 43rpx;
}
.heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}
.title {
  max-width: 540rpx;
}
.subtitle {
  margin-top: 3rpx;
}
.compact-head { padding-bottom: 12rpx; }
.compact-head .heading-row { min-height: 44rpx; }
.compact-head .title { font-size: 32rpx; }
.compact-head .subtitle { font-size: 21rpx; }

.contained-head { padding-bottom: 16rpx; }
.contained-head .title { max-width: calc(100vw - 260rpx); }

/* Opt-in Figma V3 header. The original game/guest headers keep their dimensions. */
.v3-head { padding-bottom: 46.154rpx; }
.v3-head .heading-row { min-height: 38px; gap: 12px; padding-left: 4px; }
.v3-head .title { flex: 1; min-width: 0; max-width: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 27px; font-weight: 700; line-height: 38px; }
.v3-head .subtitle { margin-top: 0; padding-left: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 14px; line-height: 20px; }
.v3-head .v3-back-title { display: flex; align-items: center; gap: 10px; font-size: 24px; line-height: 35px; }
.v3-back-icon { width: 21px; height: 21px; flex-shrink: 0; }
