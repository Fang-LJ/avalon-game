:host { display: block; width: 100%; height: 100%; }
.knowledge-mark { width: 100%; height: 100%; border-radius: 50%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.evil-mark { background: #26171c; border: 1rpx solid #9b4653; }
.evil-crescent { position: relative; width: 68%; height: 68%; border-radius: 50%; overflow: hidden; background: #e47a86; }
.crescent-cutout { position: absolute; width: 92%; height: 92%; border-radius: 50%; background: #26171c; top: -18%; right: -18%; }
.candidate-mark { background: #b69cff; color: #ffffff; font-size: 24rpx; font-weight: 900; line-height: 1; box-shadow: 0 0 10rpx rgba(182,156,255,.35); }
.role-mark { border: 1rpx solid; font-size: 22rpx; font-weight: 900; line-height: 1; }
.role-evil { background: #6f2833; border-color: #c86472; color: #fff2f2; }
.role-loyal { background: #255c62; border-color: #66c5c6; color: #dcffff; }
.role-merlin { background: #594a22; border-color: #e2bf62; color: #f5dc91; }
.role-percival { background: #493a69; border-color: #b69cff; color: #f1eaff; }
.guess-mark { background: #18231f; border: 1rpx dashed rgba(216,178,92,.75); color: #f1ddb2; font-size: 19rpx; font-weight: 600; line-height: 1; }
.guess-evil { background: rgba(111,40,51,.30); border-color: rgba(228,122,134,.75); color: #efadb5; }
.guess-loyal { color: #a2ddd7; border-color: rgba(102,197,198,.70); }
.guess-percival { color: #d3c2ff; border-color: rgba(182,156,255,.70); }
