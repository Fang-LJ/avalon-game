:host { display: block; width: 100%; height: 100%; overflow: visible; }
.knowledge-mark { width: var(--identity-mark-size, 100%); height: var(--identity-mark-size, 100%); box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.evil-mark { border-radius: 50%; background: #26171c; border: 1rpx solid #9b4653; }
.evil-crescent { position: relative; width: 68%; height: 68%; border-radius: 50%; overflow: hidden; background: #e47a86; }
.crescent-cutout { position: absolute; width: 92%; height: 92%; border-radius: 50%; background: #26171c; top: -18%; right: -18%; }
.candidate-mark { border-radius: 50%; background: #b69cff; color: #ffffff; font-size: 24rpx; font-weight: 900; line-height: 1; box-shadow: 0 0 10rpx rgba(182,156,255,.35); }
.role-mark { width: max-content; min-width: var(--identity-mark-size, 34rpx); padding: 0 var(--identity-mark-padding, 9rpx); border: 1rpx solid; border-radius: 12rpx; font-size: var(--identity-mark-font-size, 22rpx); font-weight: 900; line-height: 1; white-space: nowrap; }
.role-evil { background: rgba(90,35,45,.45); border-color: #D66A76; color: #EE8E99; }
.role-loyal { background: #172b2e; border-color: #66c5c6; color: #83d7d8; }
.role-blue { background: rgba(40,70,95,.55); border-color: #5EA7E8; color: #7FC0FF; }
.role-merlin { background: #2b261a; border-color: #e2bf62; color: #f5dc91; }
.role-percival { background: #262033; border-color: #b69cff; color: #cbb5ff; }
.guess-wrapper { position: relative; width: max-content; height: 100%; overflow: visible; }
.guess-question { position: absolute; right: -14rpx; top: 50%; transform: translateY(-50%); font-size: var(--guess-question-font-size, 20rpx); font-weight: 900; line-height: 1; color: #E5C97A; text-shadow: 0 0 3rpx rgba(0,0,0,.35); }
