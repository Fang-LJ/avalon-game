:host { display: block; width: 100%; height: 100%; overflow: visible; }
.knowledge-mark { width: var(--identity-mark-size, 100%); height: var(--identity-mark-size, 100%); box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.role-mark { width: max-content; min-width: calc(var(--identity-mark-size, 34rpx) + 8rpx); padding: 0 var(--identity-mark-padding, 9rpx); border: 1rpx solid; border-radius: 12rpx; color: #FFFFFF; font-size: var(--identity-mark-font-size, 22rpx); font-weight: 900; line-height: 1; white-space: nowrap; }
.role-evil, .evil-mark { background: #A93447; border-color: #A93447; }
.role-loyal, .role-blue { background: #147FA7; border-color: #147FA7; }
.role-merlin { background: #D79A22; border-color: #D79A22; }
.role-percival, .candidate-mark { background: #8052C1; border-color: #8052C1; }
.guess-wrapper { position: relative; width: max-content; height: 100%; overflow: visible; }
.guess-question { position: absolute; right: -14rpx; top: 50%; transform: translateY(-50%); font-size: var(--guess-question-font-size, 20rpx); font-weight: 900; line-height: 1; color: #E5C97A; text-shadow: 0 0 3rpx rgba(0,0,0,.35); }
