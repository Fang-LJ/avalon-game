<view wx:if="{{markType === 'GUESS'}}" class="guess-wrapper">
  <view class="knowledge-mark role-mark role-{{tone}}">{{text}}</view>
  <text class="guess-question">?</text>
</view>
<view wx:elif="{{markType === 'ROLE'}}" class="knowledge-mark role-mark role-{{tone}}">{{text}}</view>
<view wx:elif="{{markType === 'EVIL' || (!markType && (type === 'EVIL' || type === 'EVIL_ALLY'))}}" class="knowledge-mark role-mark evil-mark">红</view>
<view wx:elif="{{markType === 'MERLIN_OR_MORGANA' || (!markType && type === 'MERLIN_OR_MORGANA')}}" class="knowledge-mark role-mark candidate-mark">?</view>
