:host {
  display: block;
}
.track {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--soft);
  text-align: center;
  line-height: 48rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.SUCCESS {
  background: var(--good);
  color: var(--bg);
}
.FAILED {
  background: var(--evil);
}
.CURRENT {
  background: var(--gold);
  color: var(--bg);
}
