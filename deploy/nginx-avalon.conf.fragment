# Add beside the existing playmate upstream declarations.
upstream avalon_server_backend {
    zone avalon_server_backend 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server avalon-server:8081 resolve;
}

# Add inside the existing api.playmatespace.cloud TLS server block.
location /avalon/ws/ {
    proxy_pass http://avalon_server_backend/ws/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
}

location /avalon/ {
    proxy_pass http://avalon_server_backend/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
}
