TZ=Asia/Shanghai
AVALON_DB_HOST=playmate-mysql
AVALON_DB_PORT=3306
AVALON_DB_NAME=playmate_space
AVALON_DB_USERNAME=playmate
AVALON_DB_PASSWORD=REPLACE_WITH_EXISTING_MYSQL_PASSWORD
AVALON_JWT_SECRET=REPLACE_WITH_A_RANDOM_64_BYTE_SECRET
AVALON_JWT_EXPIRE_SECONDS=604800
AVALON_WECHAT_APP_ID=REPLACE_WITH_WECHAT_APP_ID
AVALON_WECHAT_APP_SECRET=REPLACE_WITH_WECHAT_APP_SECRET
AVALON_MINIO_ENDPOINT=http://playmate-minio:9000
AVALON_MINIO_ACCESS_KEY=REPLACE_WITH_EXISTING_MINIO_ROOT_USER
AVALON_MINIO_SECRET_KEY=REPLACE_WITH_EXISTING_MINIO_ROOT_PASSWORD
AVALON_MINIO_BUCKET=playmate-files
AVALON_MINIO_PUBLIC_BASE_URL=https://api.playmatespace.cloud/minio
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC -Duser.timezone=Asia/Shanghai
